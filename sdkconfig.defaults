# ArgonOS - target independent defaults.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 1 kHz tick: the supervisor needs millisecond granularity for app watchdogs.
CONFIG_FREERTOS_HZ=1000

# The kernel runs from app_main; give it room for the boot sequence.
# The shell runs on the main task, and so does the built-in file manager, whose
# deepest paths carry a couple of full paths and a copy buffer on the stack.
# 4 KB more out of 256 is a cheap way not to find that out from a reboot.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y

# Speed over size: ArgonOS exists to get out of the application's way.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ArgonOS installs its own panic handler so it can blame the right process.
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y

# We run a per-process watchdog in the supervisor instead of the IDF one.
CONFIG_ESP_TASK_WDT_INIT=n

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Long file names, off by default in ESP-IDF.  Without these a card written on
# a PC lists as READLE~1.TXT, which is not a filesystem anyone wants to share
# with a desktop.  Heap rather than stack: 255 characters is too much to put on
# the stack of every task that touches a file.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Colours in log lines are stripped by the journal anyway, and the console
# applies its own attributes.  Turning them off saves the bytes on the wire.
CONFIG_LOG_COLORS=n

# QEMU OpenEth + api->net (see ARGON_ENABLE_NET).  Not for real silicon.
CONFIG_ARGON_ENABLE_NET=y
CONFIG_ETH_USE_OPENETH=y
# Keep the Ethernet path lean: MD still needs a 32 KB internal stack, and the
# largest free DRAM block after a default lwIP bring-up was only ~31 KB.
CONFIG_ETH_OPENETH_DMA_RX_BUFFER_NUM=2
CONFIG_ETH_OPENETH_DMA_TX_BUFFER_NUM=1
# pcmvirt+midivirt+mousevirt each need listen(+conn); 4 left no room for pcmplay.
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
