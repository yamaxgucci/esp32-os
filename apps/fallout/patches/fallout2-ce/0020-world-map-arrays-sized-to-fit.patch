     }
@@ -1211,9 +1229,21 @@
         int encounterTableEntryIdx;
 
         if (fileReadInt32(stream, &encounterTableIdx) == -1) return -1;
+        // ARGON: bounds, because the arrays are now exactly as long as
+        // worldmap.txt made them.  The indices come out of a save written
+        // against the same file, so this should never fire - but "should never"
+        // and "writes past the end of a 22-entry array" are not the same claim.
+        if (encounterTableIdx < 0
+            || encounterTableIdx >= wmMaxEncounterInfoTables) {
+            return -1;
+        }
         EncounterTable* encounterTable = &(wmEncounterTableList[encounterTableIdx]);
 
         if (fileReadInt32(stream, &encounterTableEntryIdx) == -1) return -1;
+        if (encounterTableEntryIdx < 0
+            || encounterTableEntryIdx >= encounterTable->entriesLength) {
+            return -1;
+        }
         EncounterTableEntry* encounterTableEntry = &(encounterTable->entries[encounterTableEntryIdx]);
 
         if (fileReadInt32(stream, &(encounterTableEntry->counter)) == -1) return -1;
@@ -1411,6 +1441,32 @@
         if (encounterTable->entriesLength >= 40) {
             showMesageBox("\nwmConfigInit::Error: Encounter Table: Too many table indexes!!");
             exit(1);
+        }
+
+/*
+ * ARGON: grown to fit rather than declared at the worst case.
+ *
+ * The world map holds 739 KB from startup to exit on every map, and most of it
+ * is two arrays sized for a table that does not exist.  EncounterTable carried
+ * entries[41] and 76 of them are parsed out of worldmap.txt; counted from the
+ * file itself, they use 22.3 of the 41 on average.  Encounter carried
+ * entries[10] and there are 110 of them, using 3.4.  So 45% of one and 66% of
+ * the other is empty on every map the player ever stands on - about 440 KB of
+ * an arena with 6340.
+ *
+ * These are parsed once at startup and never grow afterwards, so the cost is
+ * one realloc per entry while reading a file that is already being parsed -
+ * seventeen hundred of them, once, behind the loading screen.
+ */
+        {
+            EncounterTableEntry* grown = (EncounterTableEntry*)internal_realloc(
+                encounterTable->entries,
+                sizeof(*grown) * (size_t)(encounterTable->entriesLength + 1));
+            if (grown == nullptr) {
+                showMesageBox("\nwmConfigInit::Error loading Encounter Table!");
+                exit(1);
+            }
+            encounterTable->entries = grown;
         }
 
         pConfigCfg = config;
@@ -1649,6 +1705,18 @@
     strncpy(encounter->name, name, 40);
 
     while (1) {
