+/*
+ * ARGON: the three pools the encounter data now keeps its arrays in.
+ *
+ * Filled once while worldmap.txt is parsed, never afterwards, and freed
+ * together in wmWorldMap_exit.  Each entry owns a contiguous run and says
+ * where the run starts; the run is claimed on the *first* append rather than
+ * at slot-init, because parsing one encounter table entry can parse a whole
+ * encounter base type in the middle of itself - wmParseFindSubEncTypeMatch
+ * reaches wmReadEncBaseType - and a run reserved before that happens would no
+ * longer be contiguous when it came back.
+ */
+static EncounterTableSubEntry* wmSubPool;
+static int wmSubPoolLen;
+static int wmSubPoolCap;
+
+static EncounterConditionEntry* wmCondPool;
+static int wmCondPoolLen;
+static int wmCondPoolCap;
+
+static EncounterItem* wmItemPool;
+static int wmItemPoolLen;
+static int wmItemPoolCap;
+
+/*
+ * Room for one more in a pool, in one place so the failure is in one place.
+ *
+ * Doubling rather than growing by one: this runs 5788 times over the three
+ * pools while a file is parsed and each realloc of the whole pool is a copy.
+ * The engine's own habit here is to realloc per element (see the note in
+ * wmReadEncounterType) and it can afford to - 1695 copies of an array that
+ * ends at 53 KB - but the pools are appended to five times as often.
+ *
+ * Returns false only when the arena refuses or an index would not fit in the
+ * uint16_t the entries hold.  The caller stops parsing; the engine's own
+ * habit for this class of failure is exit(1) and this keeps to it, because a
+ * half-parsed encounter table is a game that rolls the wrong monsters at the
+ * player an hour later.
+ */
+static bool wm_pool_grow(void** data, int* len, int* cap, size_t stride,
+    const char* what)
+{
+    if (*len + 1 > 65535) {
+        debugPrint("\nwmConfigInit: more than 65535 %s in worldmap.txt", what);
+        return false;
+    }
+    if (*len < *cap) {
+        return true;
+    }
+    int want = (*cap == 0) ? 64 : *cap * 2;
+    void* grown = internal_realloc(*data, stride * (size_t)want);
+    if (grown == nullptr) {
+        debugPrint("\nwmConfigInit: no room for %d %s", want, what);
+        return false;
+    }
+    *data = grown;
+    *cap = want;
+    return true;
+}
+
+static bool wmSubPoolRoom()
+{
+    return wm_pool_grow((void**)&wmSubPool, &wmSubPoolLen, &wmSubPoolCap,
+        sizeof(*wmSubPool), "encounter sub-entries");
+}
+
+static bool wmCondPoolRoom()
+{
+    return wm_pool_grow((void**)&wmCondPool, &wmCondPoolLen, &wmCondPoolCap,
+        sizeof(*wmCondPool), "encounter conditions");
+}
+
+static bool wmItemPoolRoom()
+{
+    return wm_pool_grow((void**)&wmItemPool, &wmItemPoolLen, &wmItemPoolCap,
+        sizeof(*wmItemPool), "encounter items");
+}
+
+/* The runs, read back.  Index, not pointer, so a growth cannot dangle. */
+static EncounterTableSubEntry* wmSubEntry(EncounterTableEntry* entry, int index)
+{
+    return &wmSubPool[entry->subFirst + index];
+}
+
+static EncounterItem* wmItemAt(EncounterEntry* entry, int index)
+{
+    return &wmItemPool[entry->itemsFirst + index];
+}
+
+static EncounterConditionEntry* wmCondEntry(EncounterCondition* condition,
+    int index)
+{
+    return &wmCondPool[condition->first + index];
+}
+
+static void wmEncPoolsFree()
+{
+    if (wmSubPool != nullptr) {
+        internal_free(wmSubPool);
+        wmSubPool = nullptr;
+    }
+    wmSubPoolLen = 0;
+    wmSubPoolCap = 0;
+
+    if (wmCondPool != nullptr) {
+        internal_free(wmCondPool);
+        wmCondPool = nullptr;
+    }
+    wmCondPoolLen = 0;
+    wmCondPoolCap = 0;
+
+    if (wmItemPool != nullptr) {
+        internal_free(wmItemPool);
+        wmItemPool = nullptr;
+    }
+    wmItemPoolLen = 0;
+    wmItemPoolCap = 0;
+}
