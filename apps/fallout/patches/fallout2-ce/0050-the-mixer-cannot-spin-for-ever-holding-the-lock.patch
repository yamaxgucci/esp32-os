             unsigned char buffer[1024];
             int pos = 0;
+            /*
+             * ARGON: how many turns have produced nothing at all.
+             *
+             * This loop advances `pos` by whatever the resampler gives back,
+             * and nothing here handled it giving back zero: `pos` then stays
+             * where it is, and for a *looping* buffer soundBuffer->pos wraps
+             * round instead of reaching the end - so the only two ways out,
+             * `pos >= length` and a hard error, are both unreachable and the
+             * loop runs for ever.  Holding this buffer's mutex, which is what
+             * makes it fatal rather than merely silent: every one of
+             * audioEngineCreateSoundBuffer, ...Lock and ...Release waits on
+             * it, and they are called from the game's own thread.
+             *
+             * That is the freeze Maxim has been hitting.  8 September 2026,
+             * walking into the second part of the Temple of Trials - the
+             * engine's log ends mid-sentence:
+             *
+             *     Loading sound file sprtrap.ACM...
+             *
+             * with no "succeeded." after it.  soundLoad had reached the audio
+             * engine and stopped there.  Everything else on the board went on
+             * running - the wire task, the network, the console's output -
+             * which is exactly the shape of one thread waiting on a mutex
+             * another thread will never give back.
+             *
+             * A generous bound rather than an immediate break: a resampler is
+             * entitled to swallow a few frames before it has enough to return
+             * any, and breaking on the first empty turn would clip the start
+             * of every sound.  Two hundred and fifty-six turns is 1 KB of
+             * input for this format - far past priming, and nowhere near a
+             * hang.
+             */
+            int idle = 0;
             while (pos < length) {
                 int remaining = length - pos;
                 if (remaining > sizeof(buffer)) {
@@ -75,6 +108,13 @@
                 if (bytesRead == -1) {
                     break;
                 }
+                if (bytesRead == 0) {
+                    if (++idle > 256) {
+                        break;
+                    }
+                } else {
+                    idle = 0;
+                }
 
                 SDL_MixAudioFormat(stream + pos, buffer, gAudioEngineSpec.format, bytesRead, soundBuffer->volume);
 
@@ -156,6 +196,29 @@
             soundBuffer->pos = 0;
             soundBuffer->data = malloc(size);
             soundBuffer->stream = SDL_NewAudioStream(bitsPerSample == 16 ? AUDIO_S16 : AUDIO_S8, channels, rate, gAudioEngineSpec.format, gAudioEngineSpec.channels, gAudioEngineSpec.freq);
+            /*
+             * ARGON: and if either could not be had, this slot is not usable.
+             *
+             * Both were taken unchecked, on a machine where they can fail:
+             * `size` here is a whole sound, tens of kilobytes, out of an arena
+             * that runs out.  A null `data` is read from by the mixer on the
+             * next callback; a null `stream` makes every Put fail and every
+             * Get answer -1, so the sound is silent and the slot is spent for
+             * the rest of the run - eight of those and there is no sound at
+             * all, with nothing said about why.
+             */
+            if (soundBuffer->data == nullptr || soundBuffer->stream == nullptr) {
+                if (soundBuffer->data != nullptr) {
+                    free(soundBuffer->data);
+                    soundBuffer->data = nullptr;
+                }
+                if (soundBuffer->stream != nullptr) {
+                    SDL_FreeAudioStream(soundBuffer->stream);
+                    soundBuffer->stream = nullptr;
+                }
+                soundBuffer->active = false;
+                return -1;
+            }
             return index;
         }
