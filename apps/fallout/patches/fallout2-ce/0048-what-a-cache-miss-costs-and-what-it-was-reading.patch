+extern "C" int ag_doing_now(void)
+{
+    if (ag_map_loading != 0u) {
+        return AG_WHERE_MAPLOAD;
+    }
+
+    const int mode = GameMode::getCurrentGameMode();
+
+    if ((mode & (GameMode::kDialog | GameMode::kDialogReview | GameMode::kBarter)) != 0) {
+        return AG_WHERE_DIALOG;
+    }
+    if ((mode & (GameMode::kCombat | GameMode::kPlayerTurn)) != 0) {
+        return AG_WHERE_COMBAT;
