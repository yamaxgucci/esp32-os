+/*
+ * ARGON: the files that cost the most, merged by name.
+ *
+ * "Always a dip when I attack" wants a name, not a count: an attack loads the
+ * attack animation, and if that is the dip then this table says so in one row
+ * - the file, the times it has been read, and the total the game has stood
+ * still for it.  A row with a count of one is a cold cache and unavoidable; a
+ * row with a count of thirty is the same file read thirty times, which is the
+ * cache being too small for what the game is doing, and is fixable.
+ *
+ * Ten rows, replaced by total time, so a big rare read and a small frequent
+ * one can both be in it.  Linear scans of ten strings, on the miss path only.
+ */
+static void ag_top_note(int kind, int where, unsigned kb, unsigned ms)
+{
+    if (ag_miss_name[0] == '\0') {
+        return;
+    }
+
+    int spare = -1;
+    unsigned worst_of_the_least = 0xFFFFFFFFu;
+
+    for (int i = 0; i < AG_TOP_MISSES; i++) {
+        if (ag_top_name[i][0] == '\0') {
+            if (spare < 0) {
+                spare = i;
+                worst_of_the_least = 0;
+            }
+            continue;
+        }
+        if (strcmp(ag_top_name[i], ag_miss_name) == 0) {
+            ag_top_count[i]++;
+            ag_top_ms[i] += ms;
+            ag_top_kb[i] = kb;
+            ag_top_kind[i] = (unsigned char)kind;
+            ag_top_where[i] = (unsigned char)where;
+            return;
+        }
+        if (ag_top_ms[i] < worst_of_the_least) {
+            worst_of_the_least = ag_top_ms[i];
+            spare = i;
+        }
+    }
+
+    /* A new name only displaces a row that has cost less than this one has. */
+    if (spare < 0 || (ag_top_name[spare][0] != '\0' && ag_top_ms[spare] > ms)) {
+        return;
+    }
+
+    size_t i = 0;
+    for (; ag_miss_name[i] != '\0' && i + 1 < AG_NAME_MAX; i++) {
+        ag_top_name[spare][i] = ag_miss_name[i];
+    }
+    ag_top_name[spare][i] = '\0';
+    ag_top_count[spare] = 1;
+    ag_top_ms[spare] = ms;
+    ag_top_kb[spare] = kb;
+    ag_top_kind[spare] = (unsigned char)kind;
+    ag_top_where[spare] = (unsigned char)where;
+}
+
+/*
+ * ARGON: the keys this cache has thrown out lately, so a miss can say which
+ * kind of miss it is.
+ *
+ * "The cache missed" on its own does not distinguish the two cases that matter.
+ * A file the game has never asked for before has to come off the card whatever
+ * the cache's size is - that is the price of the game living on a card.  A file
+ * the cache *had*, evicted, and now needs again is the price of the cache being
+ * too small, and it is the only one worth spending arena on.
+ *
+ * A ring of the last few hundred evictions per cache, scanned linearly on a
+ * miss.  Two hundred and fifty-six integer compares against one file read off
+ * a FAT card is not a measurable cost, and the ring is 1 KB per cache in bss.
+ */
+#define AG_GONE_RING 256
+
+static int s_gone[AG_CACHE_KINDS][AG_GONE_RING];
+static unsigned s_gone_at[AG_CACHE_KINDS];
+static bool s_gone_ready[AG_CACHE_KINDS];
+
+static void ag_gone_add(int kind, int key)
+{
+    if (kind < 0 || kind >= AG_CACHE_KINDS) {
+        return;
+    }
+    if (!s_gone_ready[kind]) {
+        for (int i = 0; i < AG_GONE_RING; i++) {
+            s_gone[kind][i] = -1;
+        }
+        s_gone_ready[kind] = true;
+    }
+    s_gone[kind][s_gone_at[kind] % AG_GONE_RING] = key;
+    s_gone_at[kind]++;
+}
+
+static bool ag_gone_has(int kind, int key)
+{
+    if (kind < 0 || kind >= AG_CACHE_KINDS || !s_gone_ready[kind]) {
+        return false;
+    }
+    for (int i = 0; i < AG_GONE_RING; i++) {
+        if (s_gone[kind][i] == key) {
+            return true;
+        }
+    }
+    return false;
+}
