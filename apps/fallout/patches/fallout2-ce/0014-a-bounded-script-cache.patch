+// ARGON: free a program and take it out of the interpreter's list.
+//
+// programFree() on its own is not enough for a program that has been run:
+// runProgram() puts it on gInterpreterProgramListHead, and _updatePrograms()
+// walks that list every frame and would dereference the freed block.  There
+// was no way to undo runProgram() because programListNodeFree() is static, so
+// here is one.
+void programDiscard(Program* program)
+{
+    ProgramListNode* curr = gInterpreterProgramListHead;
+
+    while (curr != nullptr) {
+        if (curr->program == program) {
+            // Frees the program as well.
+            programListNodeFree(curr);
+            return;
+        }
+        curr = curr->next;
+    }
+
+    programFree(program);
+}
