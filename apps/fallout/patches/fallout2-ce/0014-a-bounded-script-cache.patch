diff --git a/src/scripts.cc b/src/scripts.cc
--- a/src/scripts.cc
+++ b/src/scripts.cc
@@ -549,6 +549,105 @@
     return _cur_id;
 }
 
+
+/*
+ * ARGON: a bounded number of resident script programs.
+ *
+ * scriptExecProc() loads a script's Program the first time that script runs and
+ * nothing unloads it while the map is up, so the resident set grows for minutes
+ * after a map loads - as critters wake, doors are looked at and timers fire -
+ * and settles once every script on the map has run once.  Measured on
+ * BROKEN2.MAP, the largest map in the game: 160 programs, 1025 KB, against 1026
+ * KB for the map's seven thousand objects and 1401 KB for the whole art cache.
+ * On an 8 MB part that is the difference between the game fitting and not.
+ *
+ * A program is reloadable, which is what makes this possible.  Everything that
+ * has to survive lives in the Script struct - the procedure indices, the flags,
+ * the owner and target - and scriptExecProc() rebuilds the rest: clear
+ * SCRIPT_FLAG_0x01 and the next call loads the program, calls
+ * scriptLocateProcs() to find the procedures again, and runs the program's
+ * initialisation before the procedure it was asked for.
+ *
+ * What does not survive is a script's file-scope variables, which live in the
+ * Program.  Fallout scripts are meant to keep anything persistent in
+ * local_var/global_var, and every program is dropped on a map change in any
+ * case, so nothing can depend on them across visits - but something may depend
+ * on them within one.  That is why this is off unless asked for.
+ */
+extern "C" int ag_script_cache;
+
+// Anything mid-flight is not ours to take away.  PROGRAM_FLAG_0x02 is excluded
+// because runProgram() sets it on every program it lists, so it means "loaded"
+// rather than "busy"; the rest of the mask is the set scriptExecProc() itself
+// refuses to run (0x0124), plus waiting, stopped and critical section.
+static bool scriptProgramIsIdle(Program* program)
+{
+    const int busy = PROGRAM_FLAG_0x04 | PROGRAM_FLAG_STOPPED
+        | PROGRAM_IS_WAITING | PROGRAM_FLAG_0x20 | PROGRAM_FLAG_0x40
+        | PROGRAM_FLAG_CRITICAL_SECTION | PROGRAM_FLAG_0x0100;
+
+    if (program->exited) {
+        // The interpreter will reap it on its own next pass.
+        return false;
+    }
+    if ((program->flags & busy) != 0) {
+        return false;
+    }
+    // A spawned program shares state with the one that spawned it.
+    return program->parent == nullptr && program->child == nullptr;
+}
+
+void scriptsTrimPrograms()
+{
+    int resident = 0;
+    int excess;
+    int freed = 0;
+
+    if (ag_script_cache <= 0) {
+        return;
+    }
+
+    for (int type = 0; type < SCRIPT_TYPE_COUNT; type++) {
+        for (ScriptListExtent* extent = gScriptLists[type].head;
+            extent != nullptr; extent = extent->next) {
+            for (int index = 0; index < extent->length; index++) {
+                if (extent->scripts[index].program != nullptr) {
+                    resident++;
+                }
+            }
+        }
+    }
+
+    excess = resident - ag_script_cache;
+    if (excess <= 0) {
+        return;
+    }
+
+    for (int type = 0; type < SCRIPT_TYPE_COUNT && excess > 0; type++) {
+        for (ScriptListExtent* extent = gScriptLists[type].head;
+            extent != nullptr && excess > 0; extent = extent->next) {
+            for (int index = 0; index < extent->length && excess > 0; index++) {
+                Script* script = &(extent->scripts[index]);
+                if (script->program == nullptr) {
+                    continue;
+                }
+                if (!scriptProgramIsIdle(script->program)) {
+                    continue;
+                }
+                programDiscard(script->program);
+                script->program = nullptr;
+                script->flags &= ~SCRIPT_FLAG_0x01;
+                excess--;
+                freed++;
+            }
+        }
+    }
+
+    if (freed != 0) {
+        debugPrint("\n[argon] scripts: %d resident, dropped %d, %d left\n", resident, freed, resident - freed);
+    }
+}
