+    // overridden - see the line sfall_config.cc prints.
+    int skipOpeningMovies = 1;
     configGetInt(&gSfallConfig, SFALL_CONFIG_MISC_KEY, SFALL_CONFIG_SKIP_OPENING_MOVIES_KEY, &skipOpeningMovies);
