+/*
+ * ARGON: two heaps, so the path search stops being quadratic.
+ *
+ * The search picks the cheapest open node by scanning the open array, and
+ * finds a slot for a new node by scanning it again.  Both are linear, and
+ * the search expands up to two thousand nodes - which is exactly what it
+ * does when there is no path at all, the case that costs most.
+ *
+ * The replacement has to choose the SAME node the scan would, or critters
+ * take different routes and the game changes: the scan takes the smallest
+ * estimate+cost, and among equals the one with the smallest index.  So the
+ * heap is ordered by (estimate + cost, index), and the free slots are a
+ * heap of their own so that "the first free slot" is still the smallest.
+ *
+ * A node is never re-costed once it is in the open list (every tile is
+ * added at most once - gPathfinderProcessedTiles sees to that), so no
+ * entry in the heap ever goes stale.
+ */
+static int ag_open_heap[2000];
+static int ag_open_heap_n;
+static int ag_free_heap[2000];
+static int ag_free_heap_n;
+
+static bool ag_open_before(int a, int b)
+{
+    const int fa = gOpenPathNodeList[a].estimate + gOpenPathNodeList[a].cost;
+    const int fb = gOpenPathNodeList[b].estimate + gOpenPathNodeList[b].cost;
+
+    if (fa != fb) {
+        return fa < fb;
+    }
+    return a < b;
+}
+
+static void ag_open_push(int index)
+{
+    int at = ag_open_heap_n++;
+
+    ag_open_heap[at] = index;
+    while (at > 0) {
+        const int up = (at - 1) / 2;
+
+        if (!ag_open_before(ag_open_heap[at], ag_open_heap[up])) {
+            break;
+        }
+
+        const int swap = ag_open_heap[at];
+
+        ag_open_heap[at] = ag_open_heap[up];
+        ag_open_heap[up] = swap;
+        at = up;
+    }
+}
+
+static int ag_open_pop(void)
+{
+    if (ag_open_heap_n == 0) {
+        return -1;
+    }
+
+    const int best = ag_open_heap[0];
+
+    ag_open_heap[0] = ag_open_heap[--ag_open_heap_n];
+
+    int at = 0;
+
+    for (;;) {
+        const int left = at * 2 + 1;
+        const int right = left + 1;
+        int       small = at;
+
+        if (left < ag_open_heap_n
+                && ag_open_before(ag_open_heap[left], ag_open_heap[small])) {
+            small = left;
+        }
+        if (right < ag_open_heap_n
+                && ag_open_before(ag_open_heap[right], ag_open_heap[small])) {
+            small = right;
+        }
+        if (small == at) {
+            break;
+        }
+
+        const int swap = ag_open_heap[at];
+
+        ag_open_heap[at] = ag_open_heap[small];
+        ag_open_heap[small] = swap;
+        at = small;
+    }
+    return best;
+}
+
+static void ag_free_push(int index)
+{
+    int at = ag_free_heap_n++;
+
+    ag_free_heap[at] = index;
+    while (at > 0) {
+        const int up = (at - 1) / 2;
+
+        if (ag_free_heap[at] >= ag_free_heap[up]) {
+            break;
+        }
+
+        const int swap = ag_free_heap[at];
+
+        ag_free_heap[at] = ag_free_heap[up];
+        ag_free_heap[up] = swap;
+        at = up;
+    }
+}
+
+static int ag_free_pop(void)
+{
+    if (ag_free_heap_n == 0) {
+        return -1;
+    }
+
+    const int best = ag_free_heap[0];
+
+    ag_free_heap[0] = ag_free_heap[--ag_free_heap_n];
+
+    int at = 0;
+
+    for (;;) {
+        const int left = at * 2 + 1;
+        const int right = left + 1;
+        int       small = at;
+
+        if (left < ag_free_heap_n && ag_free_heap[left] < ag_free_heap[small]) {
+            small = left;
+        }
+        if (right < ag_free_heap_n
+                && ag_free_heap[right] < ag_free_heap[small]) {
+            small = right;
+        }
+        if (small == at) {
+            break;
+        }
+
+        const int swap = ag_free_heap[at];
+
+        ag_free_heap[at] = ag_free_heap[small];
+        ag_free_heap[small] = swap;
+        at = small;
+    }
+    return best;
+}
