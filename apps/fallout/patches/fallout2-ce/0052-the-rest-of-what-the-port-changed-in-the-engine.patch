diff --git a/src/fps_limiter.cc b/src/fps_limiter.cc
--- a/src/fps_limiter.cc
+++ b/src/fps_limiter.cc
@@ -15,10 +15,42 @@ void FpsLimiter::mark()
     _ticks = SDL_GetTicks();
 }
 
+/*
+ * ARGON: read the clock ONCE.
+ *
+ * The original read it twice - once for the test, once for the subtraction -
+ * and between those two reads time moves:
+ *
+ *     if (1000 / _fps > SDL_GetTicks() - _ticks) {
+ *         SDL_Delay(1000 / _fps - (SDL_GetTicks() - _ticks));
+ *     }
+ *
+ * Let the budget be 16 ms.  A frame that has taken 15 ms passes the test; if
+ * the millisecond turns over before the second read, the subtraction is
+ * 16 - 16... or 16 - 17, in unsigned arithmetic, which is 4294967295.  The
+ * game then sleeps for forty-nine days.
+ *
+ * That is a race a frame runs against itself, so it is rare and it is fatal.
+ * The board, 9 September 2026, seven minutes into a session:
+ *
+ *     [watch] STUCK: no frame and no lap for 5000 ms.  Step 6 (throttle)
+ *     [watch] script ... 349918 steps -> 349918 (not moving)
+ *     [watch] the sound thread is at writing to the device (still running)
+ *
+ * Everything else alive, the game thread asleep in the frame limiter.  It
+ * looked for all the world like the audio wedge and it was nothing of the
+ * kind.
+ *
+ * One read, one comparison, and a guard on _fps because a zero there would
+ * divide by zero before any of this mattered.
+ */
 void FpsLimiter::throttle() const
 {
-    if (1000 / _fps > SDL_GetTicks() - _ticks) {
-        SDL_Delay(1000 / _fps - (SDL_GetTicks() - _ticks));
+    const unsigned int budget = (_fps != 0) ? (1000u / _fps) : 16u;
+    const unsigned int elapsed = SDL_GetTicks() - _ticks;
+
+    if (elapsed < budget) {
+        SDL_Delay(budget - elapsed);
     }
 }
 
