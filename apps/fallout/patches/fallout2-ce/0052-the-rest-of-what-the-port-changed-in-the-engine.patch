+/*
+ * ARGON: the character's own animations, pinned so the map cannot evict them.
+ *
+ * Measured on the board, 9 September 2026, one minute of walking:
+ *
+ *   tile     2118 misses,  5701 ms   (2.7 ms each)
+ *   scenery  1197 misses,  3427 ms   (2.9 ms each)
+ *   wall      572 misses,  1571 ms   (2.7 ms each)
+ *   critter   216 misses, 10527 ms   (49 ms each)
+ *
+ * Critter art is five per cent of the misses and half of the lost time.  The
+ * reason is size: a walk animation is one FRM of 116 KB, while a tile is a
+ * couple of kilobytes.  Scrolling the view pulls in tiles by the dozen, they
+ * push everything else out of a cache that is already too small - and what
+ * gets pushed out includes the walk animation of the character doing the
+ * walking, which is then read again from the card a step later.  Two thousand
+ * cheap misses were evicting two hundred expensive ones.
+ *
+ * So the last few animations this character actually used are held with a
+ * reference count, which is the one thing the eviction sweep respects.  Four
+ * of them: walking, standing, and room for whatever else a step involves.
+ *
+ * Two things this must not do, and does not:
+ *
+ *   - it must not survive a map change, or the pins hold art for a critter
+ *     that is no longer there.  artCacheFlush is called on every map change,
+ *     so the pins are dropped from there.
+ *   - it must not stand in the way when the arena runs out.  A pinned entry
+ *     cannot be swept, so it would make a flush free less than it should.  The
+ *     out-of-arena hook drops every pin before it does anything else.
+ */
+/*
+ * Four became eight, measured rather than guessed.  At four, one minute of
+ * walking cost 224.6 critter misses per hundred hexes against 358.9 with no
+ * pins at all - so pinning worked, and the question was where the trade stops
+ * paying: every pin is about 116 KB that tiles cannot have, and tiles went up
+ * 19% for that first half megabyte.  Eight is the next step of the same
+ * experiment; if the total time lost per hundred hexes rises rather than
+ * falls, four was the answer and this comment says so.
+ */
+#define ARGON_PINS 8
+
+/* How many of those slots are actually used: -pins N, so the trade between
+ * animations and tiles can be measured by restarting rather than rebuilding.
+ * Four is where the first measurement put it. */
+extern "C" int ag_art_pins;
+
+static CacheEntry* argonPinEntry[ARGON_PINS];
+static int argonPinFid[ARGON_PINS];
+static int argonPinNext;
+static unsigned argonPinned, argonPinReplaced;
+
+void artDropPins()
+{
+    int i;
+
+    for (i = 0; i < ARGON_PINS; i++) {
+        if (argonPinEntry[i] != nullptr) {
+            artUnlock(argonPinEntry[i]);
+            argonPinEntry[i] = nullptr;
+        }
+        argonPinFid[i] = 0;
+    }
+    argonPinNext = 0;
+}
+
+void artPin(int fid)
+{
+    int i;
+
+    if (fid == 0) {
+        return;
+    }
+
+    if (ag_art_pins <= 0) {
+        return;
+    }
+
+    for (i = 0; i < ARGON_PINS; i++) {
+        if (argonPinFid[i] == fid && argonPinEntry[i] != nullptr) {
+            return;   /* already held */
+        }
+    }
+
+    /* Take the new one BEFORE letting the old one go: locking may evict, and
+     * the slot being reused is as good a victim as any other. */
+    {
+        CacheEntry* entry = nullptr;
+        Art* art = artLock(fid, &entry);
+
+        if (art == nullptr) {
