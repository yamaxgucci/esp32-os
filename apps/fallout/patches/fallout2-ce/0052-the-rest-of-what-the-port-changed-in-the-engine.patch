+                                                         : ARGON_PINS;
+            i = argonPinNext % slots;
+            argonPinNext = (i + 1) % slots;
+        }
+
+        if (argonPinEntry[i] != nullptr) {
+            artUnlock(argonPinEntry[i]);
+            argonPinReplaced++;
+        }
