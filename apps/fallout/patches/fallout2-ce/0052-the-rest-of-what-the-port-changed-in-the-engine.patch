+/*
+ * ARGON: the map refreshes of one animation tick, merged before they are done.
+ *
+ * Every moving object ends its step with tileWindowRefreshRect over the
+ * rectangle it left and the one it entered, and that call re-renders the map
+ * inside it - tiles, objects, light.  Measured on the board: about a thousand
+ * of them every thirty seconds, covering thirteen million pixels and costing
+ * nine seconds.  A third of the machine, spent on brahmin walking.
+ *
+ * A herd walks together, so those rectangles overlap, and every overlapped
+ * pixel is drawn again for each animal.  Collecting the tick's rectangles and
+ * merging the ones that overlap costs a few comparisons and saves the whole
+ * overlap.
+ *
+ * Merging is only done when it pays: two rectangles are joined if their union
+ * is no larger than the two of them added together.  Two animals at opposite
+ * ends of the screen therefore stay separate - joining those would redraw
+ * everything between them, which is how a well-meant optimisation becomes a
+ * slower game.
+ */
+#define AG_DEFER_MAX 12
+
+static Rect ag_defer[AG_DEFER_MAX];
+static int ag_defer_n;
+static bool ag_defer_on;
+
+static long ag_rect_area(const Rect* r)
+{
+    const long w = (long)r->right - r->left + 1;
+    const long h = (long)r->bottom - r->top + 1;
+
+    return (w > 0 && h > 0) ? (w * h) : 0;
+}
+
+/* Add one rectangle, or do it now if the tick is not collecting. */
+static void ag_refresh_rect(Rect* r, int elevation)
+{
+    if (!ag_defer_on || ag_defer_n >= AG_DEFER_MAX) {
+        ag_move_refresh_n++;
+        ag_move_refresh_px += (unsigned)ag_rect_area(r);
+        const uint32_t t0 = ag_us();
+        tileWindowRefreshRect(r, elevation);
+        ag_move_refresh_us += ag_us() - t0;
+        return;
+    }
+    ag_defer[ag_defer_n++] = *r;
+}
+
+/* Merge what overlaps, then draw what is left. */
+static void ag_refresh_flush(int elevation)
+{
+    bool merged = true;
+
+    while (merged) {
+        merged = false;
+        for (int i = 0; i < ag_defer_n && !merged; i++) {
+            for (int j = i + 1; j < ag_defer_n && !merged; j++) {
+                Rect u;
+
+                rectUnion(&ag_defer[i], &ag_defer[j], &u);
+                if (ag_rect_area(&u) <= ag_rect_area(&ag_defer[i])
+                        + ag_rect_area(&ag_defer[j])) {
+                    ag_defer[i] = u;
+                    ag_defer[j] = ag_defer[ag_defer_n - 1];
+                    ag_defer_n--;
+                    merged = true;
+                }
+            }
+        }
+    }
+
+    for (int i = 0; i < ag_defer_n; i++) {
+        ag_move_refresh_n++;
+        ag_move_refresh_px += (unsigned)ag_rect_area(&ag_defer[i]);
+        const uint32_t t0 = ag_us();
+        tileWindowRefreshRect(&ag_defer[i], elevation);
+        ag_move_refresh_us += ag_us() - t0;
+    }
+    ag_defer_n = 0;
+}
