--- a/src/art.cc
+++ b/src/art.cc
@@ -128,6 +128,9 @@
 static int* gArtCritterFidShoudRunData;
 
 // 0x418840
+/* Set by the port from -artcache; zero means use the setting. */
+extern "C" int ag_art_cache_kb;
+
 int artInit()
 {
     char path[COMPAT_MAX_PATH];
@@ -148,6 +151,20 @@
     // kilobytes, so the two ranges cannot be confused.
     int cacheSize = settings.system.art_cache_size;
     int cacheBytes = (cacheSize > 16) ? (cacheSize << 10) : (cacheSize << 20);
+
+    // ARGON: and -artcache N overrides it, in kilobytes.
+    //
+    // The right size is not something a run with -autostart can settle.
+    // Standing on a map, 1400 KB reads nothing and evicts nothing and 3000 KB
+    // costs exactly its own extra size - but standing on a map is not playing:
+    // a dialogue loads a talking head, which is some of the largest art in the
+    // game, and none of that happens with nobody at the keyboard.  So the size
+    // is a flag as well as a setting, and whoever is playing can answer the
+    // question the measurements cannot.
+    if (ag_art_cache_kb > 0) {
+        cacheBytes = ag_art_cache_kb << 10;
+        debugPrint("\nart: cache %d KB (from -artcache)\n", ag_art_cache_kb);
+    }
     if (!cacheInit(&gArtCache, artCacheGetFileSizeImpl, artCacheReadDataImpl, artCacheFreeImpl, cacheBytes)) {
         debugPrint("cache_init failed in art_init\n");
         return -1;
