+ * and returns nothing to the arena; this returns the block.  See the note in
+ * sound_effects_cache.cc for the measurement that made it necessary.
+ */
+bool soundEffectsCachePark();
+bool soundEffectsCacheUnpark();
+bool soundEffectsCacheIsParked();
 int soundEffectsCacheFileOpen(const char* fname, int* sampleRate);
 int soundEffectsCacheFileClose(int handle);
 int soundEffectsCacheFileRead(int handle, void* buf, unsigned int size);
