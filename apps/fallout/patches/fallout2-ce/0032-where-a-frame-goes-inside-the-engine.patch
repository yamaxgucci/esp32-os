             internal_free(curr);
         } else {
+            // ARGON: each ticker timed against its own address.
+            //
+            // Fallout does its per-frame work here - music streaming, the
+            // mouse, animation, the palette cycle, the script background pass
+            // - so a frame that is slow is slow in one of these, and which one
+            // is a question the board could not answer.  Keying on the
+            // function pointer means no list of names has to be kept in step
+            // with the engine: addr2line turns the address into the name after
