 // 0x4A3CA0
+/*
+ * ARGON: the per-critter profile behind [critterscript].
+ *
+ * Keyed by the script's index in scripts.lst, so the name can be printed
+ * and the script found.  Thirty-two is more than a map has slow ones; the
+ * rest fall into the overflow row.
+ */
+#define AG_CS_MAX 32
+
+static struct {
+    int      index;
+    unsigned n;
+    uint32_t us;
+    uint32_t worst;
+} ag_cs[AG_CS_MAX];
+static unsigned ag_cs_n;
+static unsigned ag_cs_lost;
+static uint32_t ag_cs_lost_us;
+
+extern "C" void ag_critter_script_took(int index, uint32_t us)
+{
+    for (unsigned i = 0; i < ag_cs_n; i++) {
+        if (ag_cs[i].index == index) {
+            ag_cs[i].n++;
+            ag_cs[i].us += us;
+            if (us > ag_cs[i].worst) {
+                ag_cs[i].worst = us;
+            }
+            return;
+        }
+    }
+    if (ag_cs_n >= AG_CS_MAX) {
+        ag_cs_lost++;
+        ag_cs_lost_us += us;
+        return;
+    }
+    ag_cs[ag_cs_n].index = index;
+    ag_cs[ag_cs_n].n = 1;
+    ag_cs[ag_cs_n].us = us;
+    ag_cs[ag_cs_n].worst = us;
+    ag_cs_n++;
+}
+
+extern "C" void ag_critter_script_report(char *out, unsigned cap)
+{
+    unsigned at = 0;
+
+    out[0] = 0;
+    for (unsigned shown = 0; shown < 4u; shown++) {
+        unsigned pick = AG_CS_MAX;
+        uint32_t best = 0;
+
+        for (unsigned i = 0; i < ag_cs_n; i++) {
+            if (ag_cs[i].n != 0u && ag_cs[i].worst > best) {
+                best = ag_cs[i].worst;
+                pick = i;
+            }
+        }
+        if (pick == AG_CS_MAX) {
+            break;
+        }
+
+        char name[32];
+
+        if (scriptsGetFileName(ag_cs[pick].index, name, sizeof(name)) != 0) {
+            name[0] = 0;
+        }
+        at += (unsigned)snprintf(out + at, cap - at,
+                                 "%s%s(#%d) %u calls, %u us, worst %u us",
+                                 (at != 0u) ? " | " : "",
+                                 (name[0] != 0) ? name : "?",
+                                 ag_cs[pick].index, ag_cs[pick].n,
+                                 (unsigned)ag_cs[pick].us,
+                                 (unsigned)ag_cs[pick].worst);
+        ag_cs[pick].n = 0;
+        ag_cs[pick].worst = 0;
+        if (at >= cap - 40u) {
+            break;
+        }
+    }
+    if (ag_cs_lost != 0u && at < cap - 40u) {
+        snprintf(out + at, cap - at, " | %u more, %u us",
+                 ag_cs_lost, (unsigned)ag_cs_lost_us);
+    }
+    ag_cs_n = 0;
+    ag_cs_lost = 0;
+    ag_cs_lost_us = 0;
+}
+
