+/*
+ * ARGON: combatai.msg is loaded when somebody says something, not at startup.
+ *
+ * It is the battle cries - 176541 bytes of them, 3537 lines, whose file begins
+ * "FALLOUT BATTLECRIES" - and they are read in exactly one place, from
+ * _combatai_msg, when a critter taunts or yelps. Measured resident on the
+ * board, 7 September 2026: 167 KB in 29 blocks, on every map, from the main
+ * menu to the end of the game, whether anything has ever fought or not.
+ *
+ * The same treatment as the world map's texts in patch 0041: loaded on the
+ * first line anybody needs, and given back when a map loads. A fight that
+ * starts after a map change pays one file read for its first shout.
+ *
+ * messageListFree leaves the list as messageListInit does, so this can happen
+ * as often as the player changes maps.
+ */
+static bool gCombatAiMsgLoaded = false;
+
+static MessageList* aiMsgs()
+{
+    if (!gCombatAiMsgLoaded) {
+        char path[COMPAT_MAX_PATH];
+        snprintf(path, sizeof(path), "%s%s", asc_5186C8, "combatai.msg");
+        if (!messageListLoad(&gCombatAiMessageList, path)) {
+            debugPrint("\naiMsgs: combatai.msg would not load\n");
+            return &gCombatAiMessageList;
+        }
+        if (settings.preferences.language_filter) {
+            messageListFilterBadwords(&gCombatAiMessageList);
+        }
+        gCombatAiMsgLoaded = true;
+        messageListRepositorySetStandardMessageList(
+            STANDARD_MESSAGE_LIST_COMBAT_AI, &gCombatAiMessageList);
     }
+    return &gCombatAiMessageList;
+}
 
