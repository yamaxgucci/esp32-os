     if (!cacheEnsureSize(cache, size)) {
+        int locked_kb = 0;
+
+        for (int i = 0; i < cache->entriesLength; i++) {
+            if (cache->entries[i]->referenceCount != 0) {
+                locked_kb += cache->entries[i]->size / 1024;
+            }
+        }
+        debugPrint("\nCACHE: cannot lend %d bytes - the sweep could not free "
+                   "it, %d of %d KB held is locked\n", size, locked_kb,
+                   cache->size / 1024);
         return false;
     }
 
     if (!heapBlockAllocate(&(cache->heap), handleIndexPtr, size, 0)) {
+        debugPrint("\nCACHE: cannot lend %d bytes - the sweep freed the room "
+                   "but the heap has no run that long; locked blocks do not "
+                   "move\n", size);
         return false;
     }
 
     if (!heapLock(&(cache->heap), *handleIndexPtr, bufferPtr)) {
         (void)heapBlockDeallocate(&(cache->heap), handleIndexPtr);
+        debugPrint("\nCACHE: cannot lend %d bytes - the block was cut but "
+                   "would not lock\n", size);
         return false;
     }
 
