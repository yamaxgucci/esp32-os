@@ -573,21 +608,50 @@ bool argonCacheBorrow(Cache* cache, int size, int* handleIndexPtr,
         return false;
     }
 
+    /*
+     * ARGON: and every refusal says which step refused.
+     *
+     * This is the path Maxim's design goes through - "no room in the RAM
+     * cache, push it out to the flash one" is exactly what cacheEnsureSize
+     * does here before the block is cut - and on 16 September 2026 it refused
