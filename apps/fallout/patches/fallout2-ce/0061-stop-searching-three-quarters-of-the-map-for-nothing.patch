+    /*
+     * ARGON: how far outside the dirty rectangle an object can still reach.
+     *
+     * The original grows the search area by a WHOLE SCREEN in every
+     * direction, so refreshing a forty-pixel square searches the same three
+     * thousand hex positions as refreshing the entire map.  Measured on the
+     * board: 100 refreshes in thirty seconds, 295200 turns of this loop,
+     * 28874 calls to the object drawer - and 480 of them drew anything.
+     * This pass is 63% of a map refresh and a map refresh is 145 ms of the
+     * worst 147 ms animation tick, which is the jolt Maxim feels.
+     *
+     * Three quarters of that search area cannot contain anything, and the
+     * drawing code says so rather than a guess.  An object is drawn from
+     *
+     *     top    = screenY - (height - 1)      bottom = screenY
+     *     left   = screenX - width / 2         right  = left + width - 1
+     *
+     * where screenX/screenY are its tile's point plus the art's offsets.
+     * So:
+     *
+     *  - an object NEVER reaches below its own tile point, which makes the
+     *    240 pixels ABOVE the rectangle useless: something up there draws
+     *    further up, away from us.  Only the art's own y offset and an
+     *    object's animation offset can push it down, and both are tens of
+     *    pixels.  Sixty-four is generous.
+     *  - sideways it reaches half its width, so 320 pixels of padding is
+     *    room for art 640 pixels wide.  Nothing in this game is a third of
+     *    that; the floor here is 192, which allows 384, and it GROWS if a
+     *    picture ever proves wider - ag_size_note keeps the widest seen.
+     *  - BELOW the rectangle the full 240 stays: a tall wall standing on a
+     *    tile under us really does draw up into view.
+     *
+     * -render 0 puts the original back, so the two can be compared.
+     */
+    int padSide = 320;
+    int padUp = 240;
+
+    if (ag_render_tight != 0) {
+        padSide = ag_reach_side + 32;
+        if (padSide < 192) {
+            padSide = 192;
+        }
+        if (padSide > 320) {
+            padSide = 320;
+        }
+        padUp = ag_reach_down + 32;
+        if (padUp < 64) {
+            padUp = 64;
+        }
+        if (padUp > 240) {
+            padUp = 240;
+        }
+    }
+
+    int minX = updatedRect.left - padSide;
+    int minY = updatedRect.top - padUp;
+    int maxX = updatedRect.right + padSide;
     int maxY = updatedRect.bottom + 240;
