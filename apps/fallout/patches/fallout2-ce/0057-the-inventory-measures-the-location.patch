diff --git a/src/map.cc b/src/map.cc
--- a/src/map.cc
+++ b/src/map.cc
@@ -824,6 +824,150 @@ int mapLoadByName(char* fileName)
 }
 
 // 0x482B34
+/*
+ * ARGON: what art this map actually needs, counted before the game starts.
+ *
+ * Maxim asked whether a location can say its art budget up front.  It can:
+ * the tile grid names two tiles per square, every object carries its fid,
+ * and the sizes are in master.IDX, which is already mapped.  Nothing here
+ * reads the card for pixels - only sizes.
+ *
+ * This is the inventory the flash store should be filled FROM, instead of
+ * from whatever the cache happened to evict: measured, 788 stored files
+ * and nine of them ever read back.
+ */
+static void ag_map_inventory(void)
+{
+    enum { kMax = 3000 };
+    static int      seen[kMax];
+    static unsigned kb_by_kind[16];
+    static unsigned n_by_kind[16];
+    unsigned        n = 0;
+    unsigned        total_kb = 0;
+    unsigned        skipped = 0;
+
+    memset(kb_by_kind, 0, sizeof(kb_by_kind));
+    memset(n_by_kind, 0, sizeof(n_by_kind));
+
+    /* Sorted insert, so the "have I seen this" question stays cheap. */
+    struct local {
+        static bool add(int *list, unsigned *len, unsigned max, int fid)
+        {
+            unsigned lo = 0, hi = *len;
+
+            while (lo < hi) {
+                const unsigned mid = lo + (hi - lo) / 2u;
+
+                if (list[mid] == fid) {
+                    return false;
+                }
+                if (list[mid] < fid) {
+                    lo = mid + 1u;
+                } else {
+                    hi = mid;
+                }
+            }
+            if (*len >= max) {
+                return false;
+            }
+            for (unsigned i = *len; i > lo; i--) {
+                list[i] = list[i - 1u];
+            }
+            list[lo] = fid;
+            (*len)++;
+            return true;
+        }
+    };
+
+    for (int elevation = 0; elevation < ELEVATION_COUNT; elevation++) {
+        if (_square[elevation] == nullptr) {
+            continue;
+        }
+        for (int tile = 0; tile < SQUARE_GRID_SIZE; tile++) {
+            const int packed = _square[elevation]->field_0[tile];
+            const int fids[2] = {
+                buildFid(OBJ_TYPE_TILE, packed & 0xFFF, 0, 0, 0),
+                buildFid(OBJ_TYPE_TILE, (packed >> 16) & 0xFFF, 0, 0, 0)
+            };
+
+            for (int k = 0; k < 2; k++) {
+                if (!local::add(seen, &n, kMax, fids[k])) {
+                    if (n >= kMax) {
+                        skipped++;
+                    }
+                    continue;
+                }
+
+                const int size = ag_art_size_of(fids[k]);
+                const unsigned kind = ((unsigned)fids[k] >> 24) & 15u;
+
+                if (size > 0) {
+                    total_kb += (unsigned)size / 1024u;
+                    kb_by_kind[kind] += (unsigned)size / 1024u;
+                    n_by_kind[kind]++;
+                }
+            }
+        }
+    }
+
+    for (Object* obj = objectFindFirst(); obj != nullptr;
+            obj = objectFindNext()) {
+        /*
+         * ARGON: a critter is not one picture.
+         *
+         * The object carries its standing pose, and the moment it takes a
+         * step the engine wants a different file - walking, running, each
+         * its own fid.  Those are not in the map at all, which is why a
+         * megabyte of critter art gets written to flash DURING play, one
+         * animation at a time, and each of those writes is the stall.
+         * They belong in the inventory.
+         */
+        if (PID_TYPE(obj->pid) == OBJ_TYPE_CRITTER) {
+            /* Poses and walking: Maxim's call.  Running as well would be 7.3 MB
+                 * of an 8 MB store, before attacks and deaths. */
+                static const int wanted_anim[] = { ANIM_WALK };
+
+            for (unsigned a = 0;
+                    a < sizeof(wanted_anim) / sizeof(wanted_anim[0]); a++) {
+                const int afid = buildFid(OBJ_TYPE_CRITTER,
+                                          obj->fid & 0xFFF,
+                                          wanted_anim[a],
+                                          (obj->fid & 0xF000) >> 12,
+                                          (obj->fid & 0x70000000) >> 28);
+
+                if (local::add(seen, &n, kMax, afid)) {
+                    const int asize = ag_art_size_of(afid);
+                    const unsigned akind = ((unsigned)afid >> 24) & 15u;
+
+                    if (asize > 0) {
+                        total_kb += (unsigned)asize / 1024u;
+                        kb_by_kind[akind] += (unsigned)asize / 1024u;
+                        n_by_kind[akind]++;
+                    }
+                }
+            }
+        }
+
+        if (!local::add(seen, &n, kMax, obj->fid)) {
+            if (n >= kMax) {
+                skipped++;
+            }
+            continue;
+        }
+
+        const int size = ag_art_size_of(obj->fid);
+        const unsigned kind = ((unsigned)obj->fid >> 24) & 15u;
+
+        if (size > 0) {
+            total_kb += (unsigned)size / 1024u;
+            kb_by_kind[kind] += (unsigned)size / 1024u;
+            n_by_kind[kind]++;
+        }
+    }
+
+    ag_map_inventory_note(n, total_kb, skipped, n_by_kind, kb_by_kind);
+}
+
