 {
     scriptSetFixedParam(gMapSid, map);
@@ -1200,6 +1344,24 @@ err:
     if (ag_map_loading != 0u) {
         ag_map_loading--;
     }
+    /* ARGON: say what this map needed, now that it is all known. */
+    ag_map_inventory();
+
+    /*
+     * ARGON: filling the store from the inventory is OFF until the loop is
+     * understood.  With it on, 808 wanted files became 94098 card reads and
+     * 312 MB in five minutes, with nothing written to flash at all - so the
+     * top-up was spinning, not working.  The inventory above still measures
+     * what the location needs (770 pictures / 3925 KB for poses and tiles,
+     * 808 / 7259 KB with walking and running), which is the number the
+     * decision rests on.
+     *
+     * The want list is not built either: artStoreTopUp still runs at the
+     * START of a map load, so a list left over from the previous load was
+     * drained there - 27000 card reads and 89 MB before the map even
+     * appeared.  Measuring must not leave anything behind it.
+     */
+
     ag_art_store_fill_end();
     ag_loan_map_end();
     AG_STEP("playing");
