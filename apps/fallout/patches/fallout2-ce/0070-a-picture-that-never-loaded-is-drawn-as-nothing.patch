 // 0x4C3830
+/*
+ * ARGON: what one refresh of the world map costs, in four parts.
+ *
+ * Maxim, 16 September 2026: "перемещение на карте мира очень тормозит".  This
+ * function is four different things and it was one number:
+ *
+ *   tiles    the 450x443 view copied out of the world map's 350x300 tiles
+ *   dim      hiding unknown subtiles and dimming unvisited ones, per pixel
+ *            over a 7x6 grid of subtiles per tile
+ *   overlay  wmRefreshInterfaceOverlay: the whole 640x480 interface frame
+ *            blitted again THROUGH A TRANSPARENCY TEST, plus the tabs, the
+ *            dial and the date
+ *   window   windowRefresh of all 640x480: composed into the screen surface
+ *            and converted into the panel
+ *
+ * The last two do not depend on the party having moved at all, which is the
+ * first thing to check once there are numbers.
+ */
+extern "C" {
+unsigned ag_wm_calls;
+unsigned ag_wm_tiles_us, ag_wm_dim_us, ag_wm_overlay_us;
+unsigned ag_wm_tiles_worst, ag_wm_dim_worst, ag_wm_overlay_worst;
+}
+
 static int wmInterfaceRefresh()
 {
     if (wmInterfaceWasInitialized != 1) {
         return 0;
     }
 
+    const uint32_t ag_w0 = ag_us();
+
     int v17 = wmWorldOffsetX % WM_TILE_WIDTH;
     int v18 = wmWorldOffsetY % WM_TILE_HEIGHT;
     int v20 = WM_TILE_HEIGHT - v18;
@@ -5610,6 +5647,8 @@ static int wmInterfaceRefresh()
         y += height;
     }
 
+    const uint32_t ag_w1 = ag_us();
+
     // Render cities.
     for (int index = 0; index < wmMaxAreaNum; index++) {
         CityInfo* cityInfo = &(wmAreaInfoList[index]);
@@ -5690,10 +5729,28 @@ static int wmInterfaceRefresh()
         v30 += v29;
     }
 
+    const uint32_t ag_w2 = ag_us();
+
     wmDrawCursorStopped();
 
     wmRefreshInterfaceOverlay(true);
 
+    const uint32_t ag_w3 = ag_us();
+
+    ag_wm_calls++;
+    ag_wm_tiles_us += ag_w1 - ag_w0;
+    ag_wm_dim_us += ag_w2 - ag_w1;
+    ag_wm_overlay_us += ag_w3 - ag_w2;
+    if (ag_w1 - ag_w0 > ag_wm_tiles_worst) {
+        ag_wm_tiles_worst = ag_w1 - ag_w0;
+    }
+    if (ag_w2 - ag_w1 > ag_wm_dim_worst) {
+        ag_wm_dim_worst = ag_w2 - ag_w1;
+    }
+    if (ag_w3 - ag_w2 > ag_wm_overlay_worst) {
+        ag_wm_overlay_worst = ag_w3 - ag_w2;
+    }
+
     return 0;
 }
 
