@@ -7,6 +7,46 @@
 
 namespace fallout {
 
+/*
+ * ARGON: a picture that was never loaded is drawn as nothing, not as a crash.
+ *
+ * 16 September 2026, in the middle of Maxim playing: a random encounter on
+ * the world map ended the session with
+ *
+ *   CACHE: ? (key 100663637) would not load - 980 of 1000 KB in the cache is
+ *          in use, 54 entries
+ *   [fault] app pc=... addr=0x00000000 cause=28 (read from an invalid address)
+ *
+ * and the faulting address resolved to transSrcCopy, nineteen bytes in.  The
+ * art cache could not find room for one interface frame, artLock answered
+ * null as it is supposed to, and the caller handed that null straight to a
+ * blit.  Somewhere among the sixty-odd callers of these two functions is one
+ * that does not check, and finding it by reading is a search of the whole
+ * engine; every one of them, though, is drawing a picture, and a picture that
+ * could not be loaded has exactly one correct appearance: absent.
+ *
+ * So the check goes here, where every path passes, and it is counted rather
+ * than hidden - a sprite that silently fails to draw is a bug report too, and
+ * the report prints the count and the last size asked for.
+ */
+extern "C" {
+unsigned ag_blit_null_n;
+unsigned ag_blit_null_w, ag_blit_null_h;
+}
+
+static inline bool ag_blit_ok(const void* dest, const void* src, int width,
+    int height)
+{
+    if (dest != nullptr && src != nullptr) {
+        return true;
+    }
+    ag_blit_null_n++;
+    ag_blit_null_w = (unsigned)width;
+    ag_blit_null_h = (unsigned)height;
+    return false;
+}
+
+
 // 0x4D2FC0
 void bufferDrawLine(unsigned char* buf, int pitch, int x1, int y1, int x2, int y2, int color)
 {
@@ -151,6 +191,11 @@ void bufferDrawRectShadowed(unsigned char* buf, int pitch, int left, int top, in
 // 0x4D33F0
 void blitBufferToBufferStretch(const unsigned char* src, int srcWidth, int srcHeight, int srcPitch, unsigned char* dest, int destWidth, int destHeight, int destPitch)
 {
+    if (src == nullptr || dest == nullptr) {
+        ag_blit_null_n++;
+        return;
+    }
+
     int stepX = (destWidth << 16) / srcWidth;
     int stepY = (destHeight << 16) / srcHeight;
 
@@ -178,6 +223,11 @@ void blitBufferToBufferStretch(const unsigned char* src, int srcWidth, int srcHe
 // 0x4D3560
 void blitBufferToBufferStretchTrans(const unsigned char* src, int srcWidth, int srcHeight, int srcPitch, unsigned char* dest, int destWidth, int destHeight, int destPitch)
 {
+    if (src == nullptr || dest == nullptr) {
+        ag_blit_null_n++;
+        return;
+    }
+
     int stepX = (destWidth << 16) / srcWidth;
     int stepY = (destHeight << 16) / srcHeight;
 
@@ -313,6 +363,10 @@ void bufferOutline(unsigned char* buf, int width, int height, int pitch, int col
 // 0x4E0DB0
 void srcCopy(unsigned char* dest, int destPitch, const unsigned char* src, int srcPitch, int width, int height)
 {
+    if (!ag_blit_ok(dest, src, width, height)) {
+        return;
+    }
+
     for (int y = 0; y < height; y++) {
         memcpy(dest, src, width);
         dest += destPitch;
@@ -323,6 +377,10 @@ void srcCopy(unsigned char* dest, int destPitch, const unsigned char* src, int s
 // 0x4E0ED5
 void transSrcCopy(unsigned char* dest, int destPitch, const unsigned char* src, int srcPitch, int width, int height)
 {
+    if (!ag_blit_ok(dest, src, width, height)) {
+        return;
+    }
+
     int destSkip = destPitch - width;
     int srcSkip = srcPitch - width;
 
