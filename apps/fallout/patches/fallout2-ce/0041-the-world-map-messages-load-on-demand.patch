 // 0x672FB0
 static MessageList wmMsgFile;
 
+/*
+ * ARGON: the world map's messages, loaded when something reads one.
+ *
+ * 739 KB in 1585 blocks, resident from startup to exit on every map, measured
+ * 2 September 2026 - and worldmap.msg is read only while the world map is on
+ * screen or an encounter is being rolled.  The arena it sits in is 6000 KB and
+ * the temple runs out at 5977, so this is the largest single thing that can be
+ * given back.
+ *
+ * messageListFree leaves the list as messageListInit does, so this can happen
+ * as often as the player opens and closes the map.
+ */
+static bool wmMsgLoaded = false;
+
+static MessageList* wmMsgs()
+{
+    if (!wmMsgLoaded) {
+        char path[COMPAT_MAX_PATH];
+        snprintf(path, sizeof(path), "%s%s", asc_5186C8, "worldmap.msg");
+        if (!messageListLoad(&wmMsgFile, path)) {
+            debugPrint("\nwmMsgs: worldmap.msg would not load\n");
+            return &wmMsgFile;
+        }
+        wmMsgLoaded = true;
+        messageListRepositorySetStandardMessageList(
+            STANDARD_MESSAGE_LIST_WORLDMAP, &wmMsgFile);
+    }
+    return &wmMsgFile;
+}
+
+/* Called from mapLoad, beside the art and sound cache flushes: a local map is
+ * being built and nothing on it reads a world map message. */
+void wmMessagesRelease()
+{
+    if (!wmMsgLoaded) {
+        return;
+    }
+    messageListRepositorySetStandardMessageList(
+        STANDARD_MESSAGE_LIST_WORLDMAP, nullptr);
+    messageListFree(&wmMsgFile);
+    messageListInit(&wmMsgFile);
+    wmMsgLoaded = false;
+}
