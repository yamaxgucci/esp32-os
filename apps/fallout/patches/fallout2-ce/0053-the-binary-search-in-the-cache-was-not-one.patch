diff --git a/src/cache.cc b/src/cache.cc
--- a/src/cache.cc
+++ b/src/cache.cc
@@ -400,7 +400,18 @@ bool cacheLock(Cache* cache, int key, void** data, CacheEntry** cacheEntryPtr)
      * is nothing to lock - and locking is what defeats compaction. */
     if (cacheEntry->referenceCount == 0
             && (cacheEntry->flags & CACHE_ENTRY_FLASH) == 0) {
-        if (!heapLock(&(cache->heap), cacheEntry->heapHandleIndex, &(cacheEntry->data))) {
+        /* ARGON: what locking a block costs.  A tick spent 1.11 seconds of
+         * its 1.16 inside artLock while cache misses accounted for five
+         * milliseconds, so the time is in here - and the heap compacts
+         * around blocks it is not allowed to move. */
+        const unsigned ag_hl0 = ag_cache_now_us();
+        const bool     ag_hl_ok = heapLock(&(cache->heap),
+                                           cacheEntry->heapHandleIndex,
+                                           &(cacheEntry->data));
+
+        ag_heaplock_us += ag_cache_now_us() - ag_hl0;
+        ag_heaplock_n++;
+        if (!ag_hl_ok) {
             return false;
         }
     }
@@ -948,33 +959,42 @@ static int cacheFindIndexForKey(Cache* cache, int key, int* indexPtr)
         return 3;
     }
 
-    int r = length - 1;
+    /*
+     * ARGON: a binary search that was not one.
+     *
+     * The original moves its bounds by a single element - l = l + 1 and
+     * r = r - 1 instead of mid + 1 and mid - 1 - so it walks the whole
+     * table one entry at a time while computing a midpoint it then throws
+     * away.  With a thousand entries in the art cache that is hundreds of
+     * steps per lookup, and lookups are the hot path: 8279 artLock calls
+     * in a thirty-second window cost 344 ms, 41 us each, while the heap
+     * inside them accounted for under four.
+     *
+     * On a Pentium this was merely wasteful.  Here it is a fifth of every
+     * map redraw.  The entries are sorted by key - the insert path keeps
+     * them so - which is what makes the proper search correct.
+     */
     int l = 0;
-    int mid;
-    int cmp;
+    int r = length - 1;
 
-    do {
-        mid = (l + r) / 2;
+    while (l <= r) {
+        const int mid = l + (r - l) / 2;
+        const int cmp = key - cache->entries[mid]->key;
 
-        cmp = key - cache->entries[mid]->key;
         if (cmp == 0) {
             *indexPtr = mid;
             return 2;
         }
-
         if (cmp > 0) {
-            l = l + 1;
+            l = mid + 1;
         } else {
-            r = r - 1;
+            r = mid - 1;
         }
-    } while (r >= l);
-
-    if (cmp < 0) {
-        *indexPtr = mid;
-    } else {
-        *indexPtr = mid + 1;
     }
 
+    /* Where it would go: the first entry with a larger key. */
+    *indexPtr = l;
+
     return 3;
 }
 
diff --git a/src/tile.cc b/src/tile.cc
