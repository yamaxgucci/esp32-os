diff --git a/src/game_sound.cc b/src/game_sound.cc
index 7ed4833..d772e41 100644
--- a/src/game_sound.cc
+++ b/src/game_sound.cc
@@ -225,7 +225,28 @@ int gameSoundInit()
     soundSetMemoryProcs(internal_malloc, internal_realloc, internal_free);
 
     // initialize direct sound
-    if (soundInit(_detectDevices, 24, 0x8000, 0x8000, 22050) != 0) {
+    // ARGON: four sections of 16 KB rather than twenty-four of 32.
+    //
+    // This is the streaming ring for background music, and the whole of it is
+    // asked for as one block the moment a track starts.  The stock 24 x 32 KB
+    // is 786432 bytes - nearly nine seconds of audio held in advance, which on
+    // a desk is free and here is an eighth of the arena.  That much stopped
+    // the game fitting in 8 MB of PSRAM at all.
+    //
+    // Eight sections of 32 KB fitted, and then only just.  256 KB has to be
+    // contiguous, and a run that had been playing happily on the Temple of
+    // Trials asked for it when the map's ambience changed, was told the
+    // largest hole in the arena was 188 KB, and ended there: the engine does
+    // not survive being refused a track, it exits.  A quarter of a megabyte
+    // asked for late, on a heap that has been in use for five thousand
+    // kilobytes, is a coin toss - and this one ends the program.
+    //
+    // Four sections of 16 KB is 64 KB: three quarters of a second of audio
+    // held in advance rather than nine, and every kilobyte of the difference is
+    // a kilobyte the art cache can have instead.  A mixer refilled every frame,
+    // and a frame of forty milliseconds, does not need more.  It is thin while
+    // a map is loading - but nine seconds was thin there too.
+    if (soundInit(_detectDevices, 4, 0x8000, 0x4000, 22050) != 0) {
         if (gGameSoundDebugEnabled) {
             debugPrint("failed!\n");
         }
