diff --git a/src/mouse.cc b/src/mouse.cc
--- a/src/mouse.cc
+++ b/src/mouse.cc
@@ -728,3 +728,25 @@ int mouse_get_last_buttons()
 }
 
 } // namespace fallout
+
+/*
+ * ARGON: where the cursor the player can see actually is.
+ *
+ * The port needed this for the one-to-one view, and asking the wrong side of
+ * the port for it is what made that view misbehave: the window began to slide
+ * before the pointer reached the edge, or only once it had been pushed past
+ * it.  The port knows the position the mouse DRIVER reports, in panel pixels,
+ * and that is not where this cursor is.  The engine does not read a position
+ * from the port at all - dinput.cc takes relative motion through
+ * SDL_GetRelativeMouseState and accumulates it here, in the picture's own
+ * 640x480, clipped by _mouse_clip to the screen rather than to the panel.  So
+ * the two drift apart as soon as either one runs into a limit the other does
+ * not have, and they were never the same thing to begin with.
+ *
+ * The hot spot is included, because the question this answers is "where is the
+ * cursor pointing", not "where does its bitmap start".
+ */
+extern "C" void ag_mouse_where(int* x, int* y)
+{
+    fallout::mouseGetPosition(x, y);
+}
