+/*
+ * ARGON: fill the store from the list a map made of itself.
+ *
+ * Two rules, both learned the hard way.
+ *
+ * ONE BUFFER, not one per picture.  The first version asked the arena for
+ * every file it read - a critter animation is around 300 KB, and the art
+ * cache reacts to a large allocation it cannot satisfy by throwing ITSELF
+ * away, so the fill kept emptying the cache the load was filling.  Here the
+ * buffer is taken once, sized to the largest picture worth keeping, and
+ * given back at the end.
+ *
+ * ORDER MATTERS, because the store is smaller than some maps need.  The
+ * caller sorts the list: floor tiles first, then the objects standing on
+ * them, then critters' standing poses, and walking animations LAST - Maxim
+ * asked for that explicitly, because a big location should spend its last
+ * kilobytes on something that is on the screen rather than on an animation
+ * that may never play.  When the store fills up the tail is simply dropped.
+ */
+void artStoreFillList(const int* fids, unsigned count)
+{
+    if (fids == nullptr || count == 0u || !ag_art_store_present()) {
+        return;
+    }
+
+    const uint32_t t0 = ag_us();
+    size_t cap = 320u * 1024u;
+    unsigned char* buf = nullptr;
+
+    while (cap >= 64u * 1024u) {
+        buf = (unsigned char*)internal_malloc(cap);
+        if (buf != nullptr) {
+            break;
+        }
+        cap /= 2u;
+    }
+    if (buf == nullptr) {
+        ag_map_fill_note(0u, 0u, 0u, 0u, count, 0u, 0u);
+        return;
+    }
+
+    unsigned kept = 0, kb = 0, already = 0, too_big = 0, left = 0;
+
+    for (unsigned i = 0; i < count; i++) {
+        int size = 0;
+
+        if (ag_art_store_full()) {
+            left = count - i;
+            break;
+        }
+        if (!ag_art_store_may_keep(fids[i])) {
+            already++;
+            continue;
+        }
+        if (artCacheGetFileSizeImpl(fids[i], &size) != 0 || size <= 0) {
+            continue;
+        }
+        if ((size_t)size > cap) {
+            too_big++;
+            continue;
+        }
+        if (artCacheReadDataImpl(fids[i], &size, buf) != 0) {
+            continue;
+        }
+        ag_art_store_offer(fids[i], buf, size);
+        kept++;
+        kb += (unsigned)size / 1024u;
+    }
+
+    internal_free(buf);
+    ag_map_fill_note(kept, kb, already, too_big, left,
+                     (unsigned)(cap / 1024u), (ag_us() - t0) / 1000u);
+}
