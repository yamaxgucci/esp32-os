# ArgonOS - the CYD as a monitor: no radios at all, every byte to the heap.
#
#   argon target esp32-cyd
#
# The CYD's job in this project is to be a screen at the end of a wire, and the
# thing that job needs is memory: a 320x240 frame is 150 KB, and a frame that
# cannot be assembled whole appears on the glass in pieces.  With the radios in
# the image the heap tops out around 125 KB free - and 92 in one piece - which
# is not enough however the code is arranged.
#
# `wifi off` does not help.  Switching the radio off hands back about 27 KB of
# what it had allocated; the rest is the stacks, the buffers and the static
# data the Wi-Fi and Bluetooth stacks reserve at link time, and only leaving
# them out of the image gets that back.
#
# What is lost with them: uploading files over HTTP, which is how a driver gets
# onto this board in one second instead of a minute of hex over the console.
# That is a real cost and it is worth paying here, because the console path
# still works and the picture does not.
CONFIG_ARGON_ENABLE_NET=y
CONFIG_ARGON_NET_WIFI=y
CONFIG_ARGON_ENABLE_BLE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_GATT_SERVER=y

# The network, with the smallest buffers that still talk: this board is a shop
# terminal, not a downloader, and every kilobyte the radio takes is a kilobyte
# its shop cannot have (24-25 Oct 2026).
#
# The numbers here are the ones that matter, and they are not small by accident.
# With the radio joined the byte-addressable heap was down to 10 KB free in
# pieces of 9, and the shop application needs its data in one piece of 18980
# bytes: `flash XIP needs 18980 data, heap has 372 free`.  Measured on the CYD,
# 25 Oct 2026:
#
#   static rx buffers 20 x 1600 = 32 KB   -> 2 x 1600 = 3 KB
#   static tx buffers  4 x 1600 =  6 KB   -> dynamic, taken while sending
#   lwIP tcp window    11520 B            -> 4096 B
#   lwIP tcp send buf  11520 B            -> 4096 B
#   lwIP sockets       12                 -> 8
#
# The window is the one that could matter to a customer: it is what the shop's
# page has to fit in flight.  The catalog page is 4 KB and one image is 20 KB,
# so a smaller window costs a few more round trips over the local network and
# nothing else.
#
# Two receive buffers is the floor, and it is a shop terminal's floor: the board
# polls the shop every three seconds with one connection in flight.  The
# transmission side is dynamic because a terminal sends rarely and holds the
# buffers all the same otherwise.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_LWIP_TCP_WND_DEFAULT=4096
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4096
CONFIG_LWIP_MAX_SOCKETS=8

# ESP-IDF's own timer task: 3584 by default and measured at 529 bytes used, so
# 2048 keeps a 4x margin.  This one is a build option and cannot be a line of
# SYSTEM.CFG - IDF creates the task before any file is read.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048

# Bluetooth stays off here on purpose: the peripheral comes with the keyboard
# host (esp_hid), and on the ESP32 that host needs Bluedroid's HID service -
# with NimBLE the image does not link (`undefined reference to
# esp_ble_hidh_dev_open`).  A BLE-only profile for this board is a build of the
# port without the keyboard host, not a line in this file.
CONFIG_ARGON_ENABLE_BLE=n
CONFIG_BT_ENABLED=n
# The shop's code never fits an arena this board can afford, so it always runs
# from flash: the eight kilobytes are better spent on the heap.
CONFIG_ARGON_APP_ARENA_KB=4

# The card's file system at the card's own sector size.  4096 is for a FAT on
# internal flash (wear levelling), which this board does not have - C: is
# littlefs.  At 4096 every one of the eight files the mount reserves carries a
# 4 KB cache, and mounting the card took 44 KB of the 136 the board has free,
# from the middle of its one 84 KB block (measured 28 Oct 2026, with the Mega
# Drive needing 64 KB of it in one piece).  At 512, about 5 KB.
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_SECTOR_4096=n
# ...and the wear-levelling layer's too: FatFs sizes every buffer to the larger
# of the two (FF_MAX_SS = MAX(SD, WL) in ffconf.h), so 512 for the card alone
# changed nothing - measured, 44 KB both ways.  Nothing here uses wear levelling.
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_SIZE_4096=n
