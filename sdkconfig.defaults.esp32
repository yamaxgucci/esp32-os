# ArgonOS - original ESP32 (Xtensa LX6), the hardware-only target.
#
# The primary platform is the S3; this target exists because the first real
# board in the project's hands is an ESP32-2432S028R ("cheap yellow display"):
# WROOM-32, 4 MB flash, NO PSRAM, ILI9341 240x320 on SPI, XPT2046 touch, SD on
# SPI, speaker on the built-in DAC.  Everything QEMU cannot answer - the level
# on a pin, a real bus transaction, a real cycle count - is answered here.
#
# What this target cannot do, and that is not a defect of the config: no PSRAM
# means no spike S-1 (execution from PSRAM), no megabyte .bss, and profile
# `lite` rather than `full`.  See docs/09-esp32-cyd.md.

CONFIG_IDF_TARGET="esp32"

# WROOM-32: 4 MB, DIO.  The 8 MB table does not fit - appfs would start past
# the end of the chip - so this target brings its own.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Frequency scaling, and this is the target where it belongs: the only one that
# links with it (the S3 image overflows its data segment by about a kilobyte),
# the only one with a battery connector on it, and the only one where the
# milliamps can be measured at all.
#
# Verified on the board 22 August 2026: the machine cruises to 160 MHz by
# itself at the prompt, `power eco` reaches 80, `esp_clk_cpu_freq` reports each
# of them, and the console survives every step - which is why the port offers
# 240/160/80 and not the crystal.  See docs/11-power.md.
CONFIG_ARGON_ENABLE_PM=y

# The code arena is instruction RAM, and on this chip that is SRAM0: 128 KB in
# total, shared with every IRAM-resident routine ESP-IDF puts there.  192 KB
# (the S3 figure) does not exist here at all.
#
# Eight, and it is the radios that decide it.  This number went 48 -> 40 -> 8
# as Wi-Fi and then Bluetooth were linked in, and the arena is what had to give
# because nothing else in that instruction RAM is optional.  It is also the
# thing no other firmware on this chip has: a slice of IRAM held in reserve so
# that an application image can be both written and executed in place.  A
# larger image is not refused - it relocates into the appfs partition and runs
# from flash instead, through the cache, which works and is slower.
#
# For measuring rather than for using the board, `argon target esp32-dsp`
# builds the same system with no radios and a 48 KB arena, which is what
# CKTBENCH wants: 36 KB of code, timed from RAM rather than through the cache.
CONFIG_ARGON_APP_ARENA_KB=8

# One radio in this image: Wi-Fi.  Bluetooth is OFF, and that is a measurement
# rather than a preference.
#
# The arithmetic was already in this file: linked, the two radios cost flash and
# about 25 KB of static RAM; *running*, Wi-Fi costs ~37 KB and Bluetooth ~54,
# and both at once leave 11 KB free, which is not a machine.  So neither starts
# unless something asks: [wifi] ssid in SYSTEM.CFG, or `wifi on` at the prompt,
# and `off` gives it back.
#
# What turned that into a decision, measured on the board 2026-09-20: `link run`
# FROM THE NEIGHBOUR answered -12 while the very same program ran when typed
# here, and the journal said why -
#
#     E proc: nodehi32.axe: no memory for a 16384 byte task stack
#     (internal SRAM and PSRAM both failed)
#
# A remote run holds one more task - the 6144-byte `noderun` in nodeproc.c - and
# the wire machinery beside it, and that was the difference between a largest
# free block of 19 KB and one big enough for the stack this board's own programs
# ask for.  Nothing here uses Bluetooth: the board has a touchscreen, not a
# keyboard to pair, and no HID host to be.  Wi-Fi stays - this is the board that
# serves files to a phone.
CONFIG_ARGON_ENABLE_NET=y
CONFIG_ARGON_NET_WIFI=y
CONFIG_ARGON_ENABLE_BLE=n
CONFIG_ETH_USE_OPENETH=n

# Monitor mode and raw 802.11 injection, off by default because a board that
# forges frames is a build-time choice (Kconfig).  Turned on here because this
# is the board MARAUDER.AXE runs on, and its Wi-Fi sniffers and attacks are that
# capability: api->wifimon is NULL without it, and the app then says so and
# offers nothing to sniff.  The frame ring is allocated only while a capture is
# running; the static cost is small.
CONFIG_ARGON_NET_WIFI_MON=y

# And the Bluetooth half of the menu goes with it.  Kept as a line rather than
# deleted so that the next reader sees the choice instead of wondering where a
# keyboard went.  BT_NIMBLE_ENABLED is deliberately NOT named here: it is a
# choice symbol, and setting one of those from a defaults file earns a warning
# about select/imply having no effect on it on every single build.
CONFIG_BT_ENABLED=n

# A panic reboots rather than halting.
#
# Halting is right on a desk with a console attached: the message stays on the
# screen and can be read.  This board serves files to a phone, and a machine
# that stops answering with no way to ask it why is worse than one that comes
# back and says "reset: panic" on the next line.  The message is printed either
# way; this decides only what happens after it.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=n

# The radio's buffers, sized for a chip whose whole internal memory is 320 KB.
# The defaults assume a part with PSRAM: static rx 10 and dynamic rx 32 alone
# are more than twenty kilobytes.  These are enough for a console, a file
# transfer and a PCM stream, and are the first thing to raise if throughput
# matters more than free memory.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# The radio's hot paths stay in flash rather than being copied into IRAM.
#
# Not a preference: with them in IRAM the image does not link at all, because
# IRAM on this chip is 128 KB, the kernel and the code arena already hold most
# of it, and these two options ask for about 28 KB more.  They buy throughput
# by keeping the receive path out of the flash cache; what they cost here is
# the ability to build.  If the arena is ever cut back, this is the first place
# to spend the room.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# The host helper on UART1 does not exist on a board and never will; leaving
# HostFS in would spend 80 KB of DRAM on its buffers and 100 ms of every boot
# on a PING nobody answers.
CONFIG_ARGON_ENABLE_HOSTFS=n

# Analogue input, off everywhere else because linking esp_adc stops the boot
# under QEMU (trap 26).  This target is not verified under QEMU - it is the one
# place the ADC can finally be tried, and the board has a light sensor wired to
# GPIO34 to try it on.
CONFIG_ARGON_ENABLE_ADC=y

# Sound.  This part has two 8-bit converters of its own and this board wires
# GPIO26 - the second of them - to an amplifier and a speaker, which is the
# only way it can make a noise: there is no codec and no USB.  Off everywhere
# else because the S3 has no converters and QEMU has no DMA for them.
CONFIG_ARGON_ENABLE_AUDIO=y

CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Forty columns, because the screen soldered to this board is 320 pixels wide
# and the system draws 8-pixel cells: forty by thirty is what fits, and the
# console has to be what fits or half of every line is off the glass.  The
# serial console shows the same grid - it is one screen, rendered twice.
CONFIG_ARGON_CONSOLE_COLS=40
CONFIG_ARGON_CONSOLE_ROWS=25

# Room for a neighbour's devices as well as this board's - see the C3 defaults.
CONFIG_ARGON_DEV_MAX=40
