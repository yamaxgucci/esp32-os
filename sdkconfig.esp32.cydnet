# ArgonOS - the CYD with Wi-Fi: the shop's terminal.
#
#   argon target esp32-cyd-net
#
# An overlay on sdkconfig.esp32.cyd (the monitor, radios out of the image).
# This is the build the shop's line ran on the CYD as `esp32-cyd` until the
# lines met (1 Nov 2026), and the one the Mega Drive was measured on.
CONFIG_ARGON_ENABLE_NET=y
CONFIG_ARGON_NET_WIFI=y

# The network, with the smallest buffers that still talk: this board is a shop
# terminal, not a downloader, and every kilobyte the radio takes is a kilobyte
# its shop cannot have (24-25 Oct 2026).
#
# The numbers here are the ones that matter, and they are not small by accident.
# With the radio joined the byte-addressable heap was down to 10 KB free in
# pieces of 9, and the shop application needs its data in one piece of 18980
# bytes: `flash XIP needs 18980 data, heap has 372 free`.  Measured on the CYD,
# 25 Oct 2026:
#
#   static rx buffers 20 x 1600 = 32 KB   -> 2 x 1600 = 3 KB
#   static tx buffers  4 x 1600 =  6 KB   -> dynamic, taken while sending
#   lwIP tcp window    11520 B            -> 4096 B
#   lwIP tcp send buf  11520 B            -> 4096 B
#   lwIP sockets       12                 -> 8
#
# The window is the one that could matter to a customer: it is what the shop's
# page has to fit in flight.  The catalog page is 4 KB and one image is 20 KB,
# so a smaller window costs a few more round trips over the local network and
# nothing else.
#
# Two receive buffers is the floor, and it is a shop terminal's floor: the board
# polls the shop every three seconds with one connection in flight.  The
# transmission side is dynamic because a terminal sends rarely and holds the
# buffers all the same otherwise.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_LWIP_TCP_WND_DEFAULT=4096
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4096
CONFIG_LWIP_MAX_SOCKETS=8

# Bluetooth stays off here on purpose: the peripheral comes with the keyboard
# host (esp_hid), and on the ESP32 that host needs Bluedroid's HID service -
# with NimBLE the image does not link (`undefined reference to
# esp_ble_hidh_dev_open`).  A BLE-only profile for this board is a build of the
# port without the keyboard host, not a line in this file.
CONFIG_ARGON_ENABLE_BLE=n
CONFIG_BT_ENABLED=n

# The shop's code never fits an arena this board can afford, so it always runs
# from flash: the eight kilobytes are better spent on the heap.
CONFIG_ARGON_APP_ARENA_KB=4
