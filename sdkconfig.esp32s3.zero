# ArgonOS - ESP32-S3-Zero (Waveshare) board pack.
#
# ESP32-S3FH4R2: 4 MB quad flash, 2 MB quad PSRAM, native USB only (no
# USB-to-UART bridge), no display, no SD card.  Sound is an external I2S DAC on
# GPIOs named in BOARD.CFG (audio.bclk/ws/dout/mclk).
#
# Layered after sdkconfig.defaults.esp32s3, which assumes an N16R8 module
# (8 MB flash, octal PSRAM, UART console); this trims it to what this chip has.

# 4 MB flash and a partition table of this board's own.  C: (sysfs, littlefs)
# holds BOARD.CFG - there is no card on this board - and, because this board is
# the flasher of the C3 beside it, the C3's FIRMWARE: about a megabyte, which
# does not go into the 512 KB the ordinary 4 MB table gives C:.  So C: and the
# loader's slot area are swapped round; see partitions_4mb_zero.csv for what
# that costs and why reading it over the wire instead was rejected.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb_zero.csv"

# This module's PSRAM is quad, not the octal the primary target assumes.  It is
# on because the bigger apps - DX7 and the like - ask for a ~192 KB arena that
# only extended memory can give; a tone needs none of it, but there is no reason
# to withhold 2 MB from a board that has it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# The code arena is internal SRAM, so it stays small: 192 KB here overflowed
# DRAM once PSRAM's own management took its share.  It was 64 KB until 8 Oct
# 2026; now 16 KB for the drivers, and a program that does not fit takes its
# code from the internal heap while it runs - see the end of this file.

# No host helper: H: is the emulator's, and on this board UART1 is the wire to
# the C3.  Left on, HostFS opened it at 115200 for three seconds after boot,
# sent its pings down the cluster wire and read from the port the link's DMA
# reads - and the IDF said "uhci_receive: controller not in enable state".
CONFIG_ARGON_ENABLE_HOSTFS=n

# Take the real-radio network path, not the OpenCores-MAC one.  The primary
# esp32s3 target is QEMU, where "networking" means the emulated OpenEth device
# and the boot brings it up unconditionally; on real silicon that MAC does not
# exist and ag_net_init() hangs waiting for it.  With ARGON_NET_WIFI set the net
# layer uses the radio instead and starts nothing at boot unless [wifi]/[ap] in
# BOARD.CFG (or `wifi on`) asks - so a headless audio board pays no RAM for it.
CONFIG_ARGON_ENABLE_NET=y
CONFIG_ARGON_NET_WIFI=y
CONFIG_ARGON_NET_WIFI_AP=y

# The only console this board exposes is the chip's native USB-Serial-JTAG:
# there is no UART bridge, so UART0 would talk to unconnected pins.  The port's
# console backend routes to the usb_serial_jtag driver when this is set (see
# components/argon_port/idf/argon/port/impl/uart.h).
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The device table, and this board needs the biggest one: as the middle of the
# star it registers a proxy for every device of BOTH neighbours beside its own.
# The CYD alone publishes thirteen (screen, touch, card, converter, mixer, the
# buses), the C3 ten, and this board has ten of its own - so the default of 24
# would refuse the second neighbour's registry part way through, once per
# device.  See CONFIG_ARGON_DEV_MAX and net/noderdev.c.
CONFIG_ARGON_DEV_MAX=56

# ---------------------------------------------------------------------------
# INTERNAL SRAM BACK FROM THE CHIP LAYER - MEASURED ON THIS UNIT, 8-9 OCT 2026.
#
# Of the S3's 512 KB, ESP-IDF linked 110 KB of its own code into IRAM and the
# code arena reserved 64 KB more before the heap got anything: 201 KB of heap,
# 104 KB of it free with NODELINK up.
#
# What moved, and what each was measured to cost against the clean e906cc8 -
# the same C: written back before every run (littlefs's directory log grows
# with every copy and del, and load times grow with it), NODELINK up:
#
# - IDF code never called with the flash cache off goes to flash: the heap,
#   ringbuf, the Wi-Fi and PHY fast paths, the libc locks, a few driver ISRs
#   this board does not register as IRAM.  Wi-Fi throughput is NOT measured:
#   on 9 Oct the router refused this board's join, on the old firmware too.
# - FreeRTOS stays in IRAM.  In flash it saved 10 KB and cost `dir` 0.25 ->
#   0.31 s and TUBEBENCH another 0.5% of a core: every lock and queue call of
#   a long path competing for the 32 KB instruction cache.
# - Not SPI_FLASH_ROM_IMPL: 8 KB, and GRIND.AXE loaded in 113 ms, not 87.
# - The arena keeps 16 KB internal (every .SYS on this board fits).  A program
#   whose code does not fit takes it from the internal heap while it runs
#   (loader.c, place_heap): TUBEBENCH's 40 KB loads in the 74 ms it took from
#   the old 64 KB arena.  The 256 KB PSRAM arena is for when the heap cannot
#   spare it.
# - Kernel tables marked AG_PORT_SLOW_BSS go to PSRAM - the end of this file.
#
# The budget tick hook reads pxCurrentTCBs instead of calling
# xTaskGetCurrentTaskHandleForCore (tick_hw.c): not needed while FreeRTOS is
# in IRAM, kept so that moving it out again cannot crash a flash write.
# ---------------------------------------------------------------------------
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_PHY_IRAM_OPT=n
CONFIG_LIBC_LOCKS_PLACE_IN_IRAM=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=n
CONFIG_MCPWM_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
CONFIG_ARGON_APP_ARENA_KB=16
CONFIG_ARGON_APP_ARENA_PSRAM=y
CONFIG_ARGON_APP_ARENA_PSRAM_KB=256

# Kernel tables marked AG_PORT_SLOW_BSS (argon/port/place.h) go to PSRAM: the
# module table, the VFS's, the configuration, the first prompt's context and
# the cluster's request buffers - read by tasks only, never by an interrupt or
# under a flash write.  The device table stays internal: in PSRAM it cost
# TUBEBENCH 2% of a core (device.c).  IDF puts Wi-Fi's and lwIP's .bss in
# PSRAM under the same flag.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
