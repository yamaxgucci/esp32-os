# ArgonOS - the ESP32-S3 board on the desk, as opposed to the one QEMU runs.
#
#   argon target esp32s3-board
#
# An overlay on sdkconfig.defaults.esp32s3, which is the primary target and is
# also the only target the emulator runs.  What differs is the two things a
# board has that the emulator does not - real radios and a card no host helper
# stands in for - and the one thing the emulator has that a board must not use.
#
# HOSTFS talks to tools/hostfsd.py over UART1.  A board never has that helper:
# it would cost 80 KB of DRAM and a slice of every boot for a drive that can
# never mount.  Files reach the board over the console (`recv`) and off the
# card.  Off.
#
# The radios go the other way - on.  The emulator has none, so the primary
# target leaves them out; but the whole reason this chip is on the desk and the
# ESP32-CYD is not is that here a radio and a full-size application fit at once.
# With NET_WIFI set, the network layer takes the real-radio path and never
# touches the OpenCores MAC (that code is the no-radio branch), so ENABLE_NET
# is the socket API over Wi-Fi rather than over a device that is not there.  A
# radio still starts only when something asks - [wifi]/[ap] in BOARD.CFG, or
# `wifi on` / `bt on` - so a board told to do neither pays nothing at boot.
#
# Everything else - 8 MB octal PSRAM, 240 MHz, 32 KB of instruction cache, the
# 192 KB arena - is left exactly as the emulator has it, so the numbers off
# this board can be compared with the ones in the docs.

CONFIG_ARGON_ENABLE_HOSTFS=n

CONFIG_ARGON_ENABLE_NET=y
CONFIG_ARGON_NET_WIFI=y
CONFIG_ARGON_NET_WIFI_AP=y
CONFIG_ARGON_NET_ESPNOW=y
CONFIG_ARGON_NET_WIFI_MON=y

CONFIG_ARGON_ENABLE_BLE=y
CONFIG_ARGON_BLE_CENTRAL=y
CONFIG_ARGON_BLE_PERIPHERAL=y

# NimBLE, not Bluedroid: without these the S3 falls back to Bluedroid, whose
# header esp_nimble_hci.h the port does not include and the build stops.  The
# same block the ESP32-CYD target carries, minus the BTDM_CTRL_MODE lines,
# which name the original chip's dual-mode controller - the S3's is BLE-only
# already.  Peripheral is on because ESP-IDF puts the whole NimBLE HID host
# behind the GATT server; NVS persist so a bonded keyboard is remembered
# across a power cut, and coexistence so Wi-Fi and BLE share the one radio.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- what the two radios cost, and what is trimmed so both can be up ---------
#
# Both radios in one image was never the question (section 5 of
# logs/firmware-size-ble.md has the numbers): at link time there are ~100 KB
# of internal RAM to spare once the kernel's statics live in PSRAM.  Running
# them at the same time is the question, and it is answered in kilobytes that
# are taken when a radio starts:
#
#   `ble adv`  -> 66 KB   (the controller's 30 720-byte exchange memory, the
#                          NimBLE host, its task, its buffers)
#   `wifi on`  -> 49 KB   (driver task and stack, lwIP, and 10 x 1600-byte
#                          static receive buffers)
#
# 66 + 49 is more than the board has, and the failure is not a clean "no
# memory": Wi-Fi got 8 of its 10 receive buffers, said "Expected to init 10 rx
# buffer, actual is 8", and then could not deinitialise itself either
# (measured on the S3-CAM, 23 Oct 2026).  So three things come down to what a
# board that installs programs actually needs:
#
#   - four static receive buffers instead of ten.  These are the ones held for
#     the life of the radio; the dynamic pool below covers bursts, and a shop
#     client downloads one file at a time over a link that is idle otherwise.
#   - sixteen dynamic buffers instead of thirty-two, receive and transmit: the
#     cap is on what *can* be allocated, so this is headroom given back to the
#     heap rather than memory saved at init.
#   - sixteen kilobytes of application code arena instead of thirty-two.  The
#     arena is where an application's instructions run when they cannot run
#     from PSRAM; on this board PSRAM reaches the instruction bus, so the
#     arena's real work is the odd image that needs a contiguous block, and
#     16 KB is four times the largest .SYS here.  It is set where the arena is
#     described below, not here.
#
# What is *not* trimmed: TX_BUFFER_TYPE, RX_BA_WIN, the management buffers, and
# coexistence.  The first two are throughput and the last is the whole point.
# Measured after the trim: both radios up with the Wi-Fi joined, the BLE
# advertising, and the store polling the shop - see the plan, F6.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# The photoresistor/ADC path: no work to enable, only a board to run it on -
# esp_adc would not even let QEMU boot (pitfall 26), so the primary target
# leaves it off.  Here it is real.
CONFIG_ARGON_ENABLE_ADC=y

# The code arena lives in PSRAM (S-1), which is the real answer to "a radio and
# a full-size application at once".  On the S3 instruction RAM and the
# DMA-capable data RAM are one physical SRAM, so an arena in internal memory and
# the radios fight over the same ~330 KB - 192 KB of arena overflowed the link
# by 75 KB with both radios on.  PSRAM reaches the instruction bus on this chip,
# so the arena moves there: 512 KB of code space that costs PSRAM, not internal
# memory, and the internal SRAM it used to hold goes to Wi-Fi and Bluetooth.
#
# A small internal arena stays as a fallback and for the odd image the PSRAM
# path cannot take (a contiguous one - none are built for xtensa, but the code
# still handles it).  The cost of the PSRAM arena is speed: an inner loop that
# misses the cache pays PSRAM latency, so a hot-text split will come later; this
# is the coarse form that makes everything fit.
#
# 512 KB was chosen to hold "the biggest images in the tree", and then the
# biggest image in the tree turned out to be 768 KB - Fallout 2 - so it goes to
# flash XIP regardless and the arena holds nothing.  Meanwhile it is taken out
# of PSRAM on the first load and never given back, which on an 8 MB part is
# half a megabyte of the six that game needs, and it is exactly why it refused
# to start on the board while running in the emulator.
#
# 64 KB instead, which is enough for every .SYS on this board several times
# over and for the small applications; what is bigger already paid for flash
# XIP.  Raise it again the day an image lands in that band and is hot enough
# to care - XIP costs about 300 cycles on a miss (docs/07).
#
# The arena is the whole game here, literally: with Fallout 2 the difference
# between running and not is a couple of hundred kilobytes, and every one of
# them has to come from outside its own arena, because inside it the art cache
# gives nothing back - shrinking that from 1800 to 1400 KB was measured at 0.16
# frames a second and four hundred evictions a window.
#
# 16 KB of internal arena, not 32 (23 Oct 2026): it is reserved at link time
# whether anything runs in it or not, and it was the block standing between
# "Bluetooth advertising" and "Wi-Fi joined" - see the radio note above.  What
# goes through it on this board is a .SYS of two or three kilobytes; everything
# larger already runs from the 64 KB PSRAM arena.
CONFIG_ARGON_APP_ARENA_KB=16
CONFIG_ARGON_APP_ARENA_PSRAM=y
CONFIG_ARGON_APP_ARENA_PSRAM_KB=64

# Camera transport for the DVP GC2145 on this board (api->cam); the sensor
# driver is a loadable .SYS (GC2145.SYS), so the firmware carries only the
# thin LCD_CAM+DMA path.
CONFIG_ARGON_ENABLE_CAMERA=y

# USB host, for a wired keyboard on the OTG port.  This board has two USB-C
# sockets: UART (the CH343 bridge, console and flash) and OTG (the native USB
# on GPIO19/20).  The keyboard goes on OTG through a USB-C-to-USB-A adapter, and
# the board powers it - host mode sources 5 V on that port's VBUS.  The console
# stays on the UART port, so the two do not collide.  Boot protocol only; a
# keyboard's reports become console events through the same parser a BLE
# keyboard's do.  Not verifiable in QEMU (no USB host); the gate is the board.
CONFIG_ARGON_USB_HOST=y

# See devices behind an external hub.  IDF leaves this off by default, so a
# keyboard plugged into a hub (rather than straight onto the OTG port) enumerates
# the hub and then nothing - the downstream port is never walked.  On here for
# two reasons: a hub is a normal way to attach the keyboard, and a powered hub
# supplies the keyboard's 5 V itself, which is the clean answer to the OTG port's
# shared-VBUS current budget.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# USB host timing, tuned for a keyboard behind a passive hub on this board's OTG
# port powered from the host PC.  The failure without these is an XFER error on
# the first control transfer (usbh.c: "Dev 0 EP 0 Error", not STALL): the 5 V
# rail dips on the hub+device inrush and the host resets the port and asks for
# the descriptor before the device has settled.  The chip itself does not reset
# (the brownout detector holds), so the fix is to wait longer at every step -
# power-on-to-good, connection debounce, reset hold and reset recovery - and to
# retry the downstream-port reset.  Cost: a second or two per enumeration, which
# for a keyboard is nothing.
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=500
CONFIG_USB_HOST_RESET_HOLD_MS=50
CONFIG_USB_HOST_RESET_RECOVERY_MS=200
CONFIG_USB_HOST_SET_ADDR_RECOVERY_MS=50
CONFIG_USB_HOST_EXT_PORT_RESET_ATTEMPTS=3
CONFIG_USB_HOST_EXT_PORT_RESET_RECOVERY_DELAY_MS=200
CONFIG_USB_HOST_EXT_PORT_CUSTOM_POWER_ON_DELAY_ENABLE=y
CONFIG_USB_HOST_EXT_PORT_CUSTOM_POWER_ON_DELAY_MS=500

# The UART interrupt was tried in IRAM here (CONFIG_UART_ISR_IN_IRAM) on the
# theory that its handler was thrashing the flash cache both cores share.  It
# changed nothing measurable, and it costs more internal memory than this board
# can spare: the UART driver then wants its rings in internal RAM, three
# installs fail, and the game faults.  Written down so it is not tried twice.

# The chip is an N16R8: 16 MB of flash, of which the shared 8 MB baseline table
# addressed only half.  The upper 8 MB becomes artfs, a raw partition holding
# decompressed game art (see partitions_16mb.csv).  Every offset below
# 0x800000 is unchanged, so switching tables erases nothing.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# Room for a neighbour's devices as well as this board's (30 Sep 2026): at
# the default 24 the S3-CAM, with its radios and its own soft screen, took
# only eight of the CYD's fifteen - null, zero, the console, the buses - and
# not the screen, the sound or the card (-23, the registry full), so the
# picture went into its own fb0.  The C3 has 48 and the CYD 40.
CONFIG_ARGON_DEV_MAX=48

# The flash on four lines (QIO), not two (DIO).  Code and every mapped file
# (fs->map, the cold part of a split .AXE) run from flash through the cache,
# and a miss is a line read over SPI; QIO halves its data phase.  The S3-CAM's
# flash (Boya, id 68 4018) takes the bootloader's default QE setting and boots
# in QIO.  Measured 31 Oct 2026 with XIPBENCH over a 512 KB file mapped from
# C:, three runs each, DIO -> QIO: a random read that misses 1932 -> 1118 ns,
# a sequential one 260 -> 152 ns a word; SRAM unchanged.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
