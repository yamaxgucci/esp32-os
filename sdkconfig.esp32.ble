# ArgonOS - the ESP32 board with Bluetooth instead of Wi-Fi.
#
#   argon target esp32-ble
#
# An overlay on sdkconfig.defaults.esp32, and the two radios are an either-or
# rather than a preference.  With both stacks linked the 128 KB of instruction
# RAM this chip has is 99.5% full, the general heap falls below what a single
# application needs, and there is nothing left to cut that is not the system
# itself.  A board that needs both wants an S3 with PSRAM.
#
# What this build is for: a keyboard.  The original ESP32 has no USB at all -
# the socket on the board is a serial bridge - so BLE HID is the only way to
# attach one, and a machine that cannot be typed on needs a cable to another
# computer to be used at all.

CONFIG_ARGON_ENABLE_NET=n
CONFIG_ARGON_NET_WIFI=n

CONFIG_ARGON_ENABLE_BLE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# BLE only, and NimBLE rather than Bluedroid: the controller's classic half is
# handed back at start (about 30 KB), and NimBLE is roughly half of Bluedroid.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Central and observer are the roles this system actually plays: it looks for
# devices and connects to them.  Peripheral is on anyway, and not by choice -
# see the HID option below.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# The whole of ESP-IDF's NimBLE HID *host* is behind this one option, whose
# name says service, whose default is off, and whose Kconfig menu depends on
# the GATT *server* - which is why the peripheral role above is on in a build
# that is only ever a central.  Without it esp_hidh_init has no implementation
# and the link fails on esp_ble_hidh_init, which names nothing about the cause.
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_HID_SERVICE=y

# A keyboard is bonded once and remembered.  Without this it asks to be paired
# again after every power cut - and pairing is done from a keyboard.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Sixteen, not forty.  The Bluetooth controller wants about 20 KB of IRAM that
# the arena was holding, and this build is for typing rather than for timing
# the circuit solver.  An image larger than this executes from flash instead of
# from RAM, which still works and is simply slower.
CONFIG_ARGON_APP_ARENA_KB=16
