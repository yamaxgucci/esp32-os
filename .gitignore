# ESP-IDF build output
build/
build-*/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Copied from IDF at CMake configure (fatfs component override)
components/fatfs/Kconfig

# Host test output
CMakeFiles/
CMakeCache.txt
*.o
*.a
*.elf
*.bin
*.map
Testing/

# Machine specific toolchain paths
tools/local-env.ps1

# Fetched by apps/gfxbench/build.py (LVGL v9.3.0). Not vendored.
third_party/lvgl/

# Fetched by apps/fallout/build.py. The engine is under the Sustainable Use
# License - not an open licence, and no commercial use - so it stays out of
# this repository entirely; what lives in apps/fallout is the port, Apache-2.0
# like the rest. adecode and fpattern are MIT and are fetched with it rather
# than separately.
third_party/fallout1-ce/
third_party/adecode-src/
third_party/fpattern-src/

# Reference recordings, cabinet impulses and NAM captures: third party, and
# 177 MB of them. assets/audio/guitar-di/README.md says what each one is, where
# it came from and what its noise floor measures, which is the part worth
# keeping in the repository.
assets/**/*.wav
assets/**/*.nam
assets/**/*.pk

# Python bytecode from the host tools
__pycache__/

# Editors / OS
.claude/
.vscode/
.idea/
.cache/
compile_commands.json
*.swp
Thumbs.db
desktop.ini
.DS_Store
