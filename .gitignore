# ESP-IDF build output
build/
build-*/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Copied from IDF at CMake configure (fatfs component override)
components/fatfs/Kconfig

# Host test output
CMakeFiles/
CMakeCache.txt
*.o
*.a
*.elf
*.bin
*.map
Testing/

# Machine specific toolchain paths
tools/local-env.ps1

# Fetched by apps/gfxbench/build.py (LVGL v9.3.0). Not vendored.
third_party/lvgl/

# Reference recordings, cabinet impulses and NAM captures: third party, and
# 177 MB of them. assets/audio/guitar-di/README.md says what each one is, where
# it came from and what its noise floor measures, which is the part worth
# keeping in the repository.
assets/**/*.wav
assets/**/*.nam
assets/**/*.pk

# Python bytecode from the host tools
__pycache__/

# Editors / OS
.claude/
.vscode/
.idea/
.cache/
compile_commands.json
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Board WiFi password, read by the flashing tools (assets/pwd). Never committed.
assets/pwd

# Board transcripts are RENDERED SCREENS - the same rows painted over and over -
# so one run is megabytes of repetition.  The numbers out of them are extracted
# into logs/*.md, and THAT is committed: the last round of SPI work put every
# raw log in build/cluster-stash/ and lost the lot, because build/ is what
# `argon target` deletes.  Evidence lives in logs/, and its readable part lives
# in git.
logs/*.log
logs/SYSTEM-*.CFG
