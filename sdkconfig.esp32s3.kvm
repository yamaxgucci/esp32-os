# ArgonOS - the S3 as a keyboard and mouse for somebody else's computer.
#
#   argon target esp32s3-kvm
#
# An overlay on sdkconfig.esp32s3.board, which is the board on the desk.  One
# thing changes and it changes everything about the OTG port: the peripheral
# stops being a host and becomes a device.
#
# That is not a preference, it is the silicon.  The S3 has one OTG controller
# behind one internal PHY, so an image is a host or a device and never both -
# hence ARGON_USB_HOST=n right below.  A board that wants a keyboard plugged
# into it wants the other target.
#
# The console has to be somewhere else, and on this board it already is: the
# CAM board has two USB-C sockets, a CH343 bridge for the console and flashing,
# and the native USB on GPIO19/20.  The bridge is untouched by any of this.  On
# a board whose only socket is the native one (the S3-Zero) this target would
# take the console with it, and there is no way around that short of wiring a
# UART out to pins.
#
# The PC at the other end powers the board through that socket, which is the
# other reason this is a target of its own: a board in host mode sources 5 V on
# the same pins.

CONFIG_ARGON_USB_HOST=n
CONFIG_ARGON_USB_DEVICE=y

# Two HID interfaces: boot keyboard and absolute pointer.  TinyUSB sizes its
# class table from this, so it is a build-time number and it has to agree with
# what components/argon_port/idf/src/usbdev_hw.c publishes.
#
# Two and not three because of the endpoint budget below: the relative boot
# mouse was the interface that had to go to make room for the drive.
CONFIG_TINYUSB_HID_COUNT=2

# The screen pipe beside the keyboard: a vendor (WinUSB) interface, and the
# only way a picture can come back - USB has no class for a display sink.  On
# the far machine Windows binds its built-in winusb.sys to it with nothing
# installed, no COM port and no .inf, because the device advertises a Microsoft
# OS 2.0 descriptor set through its BOS (see usbdev_hw.c, desc_bos).  This is a
# CDC replacement: TINYUSB_CDC_ENABLED=n removes that class, and the port flag
# ARGON_USB_DEVICE_CDC (which drives AG_PORT_HAS_USB_CDC) still means "the pipe
# is present" - it now selects the vendor pipe.  It defaults to y; it is pinned
# here so the meaning is on the page.
#
# One interface, one IN endpoint.  That is the whole reason the drive fits: CDC
# took two IN endpoints (a notification nobody read plus the bulk), the vendor
# interface takes one, and the endpoint it hands back is the drive's.
CONFIG_ARGON_USB_DEVICE_CDC=y
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_VENDOR_COUNT=1

# The buffers the picture flows through, and the one number worth tuning here.
# Traffic is almost entirely one way - the far machine sends tiles, this end
# sends the odd line of clipboard text back - so the receive side gets the
# room.  These are internal RAM, not PSRAM: they are DMA buffers.
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=4096
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=1024
CONFIG_TINYUSB_VENDOR_EPSIZE=64

# The flash drive is back, and the vendor pipe is what made room.  The S3's OTG
# core has five IN endpoints TOTAL and the control endpoint EP0 is one of them,
# so only FOUR are left for functions.  They are now the keyboard, the pointer,
# the vendor pipe's single bulk IN, and mass storage's bulk IN - exactly four,
# which fits.  With CDC's two IN endpoints this was five and the device would
# not start (TinyUSB's dfifo_alloc asserted "allocated_epin < ep_in_count",
# Windows error 10, connect/disconnect loop).  Found on the board 21 Oct; the
# fix is the vendor interface, not giving up the drive.
#
# The drive is how KVMAGENT.EXE reaches a machine that has never seen this
# device: it is already on the drive.  4 KB MSC transfer buffer (found on the
# board - 512 B was too small).
CONFIG_ARGON_USB_DEVICE_MSC=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096

# The partition table still carries `usbdisk` (harmless, unused) so the layout
# does not change if the drive comes back.  See partitions_kvm.csv.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_kvm.csv"

# The T-Dongle's flash has not been tried in QIO (sdkconfig.esp32s3.board turns
# it on for the S3-CAM).  A flash that does not take the bootloader's QE write
# does not boot at all, so this board stays on two lines until it is checked.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# TLS buffers in PSRAM, not internal RAM.  The relay leg is TLS now, and an
# mbedTLS handshake takes ~20-30 KB; taken from internal RAM it left Wi-Fi with
# no RX buffers after a session, so the board stopped ACKing mid-handshake and
# could not dial back.  The dongle has 8 MB of PSRAM for this.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Over-the-air system update: the KVM relay pushes an image into the spare slot
# (partitions_kvm.csv has two), so a dongle in place never needs a button press.
CONFIG_ARGON_NET_OTA=y
