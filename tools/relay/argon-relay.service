[Unit]
Description=Argon KVM relay (pairs board and phone over the VPS public IP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=argonrelay
Group=argonrelay
EnvironmentFile=/etc/argon-relay/relay.env
ExecStart=/usr/bin/python3 /opt/argon-relay/relay.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
