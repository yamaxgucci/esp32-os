#!/usr/bin/env python3
# argon-push <board-id> <app|os> <file>
#
# Push new software to a KVM board through the relay, over the board's own TLS
# connection: "app" replaces C:\KVM.AXE, "os" installs a system image into the
# spare slot.  The board checks the SHA-256 and restarts into it.  It refuses
# unless its owner put "update" in KVMRLY.TXT.
import hashlib, socket, sys

if len(sys.argv) != 4 or sys.argv[2] not in ("app", "os", "disk"):
    sys.exit("usage: argon-push <board-id> <app|os|disk> <file>\n"
             "  app  = C:\\KVM.AXE, os = system image, disk = the agent's flash drive")
bid, kind, path = sys.argv[1:]
data = open(path, "rb").read()
sha = hashlib.sha256(data).hexdigest()
s = socket.create_connection(("127.0.0.1", 7999), timeout=300)
s.sendall(("PUSH %s %s %d %s\n" % (bid, kind, len(data), sha)).encode() + data)
print("sent %s %d bytes sha %s..., waiting for the board" % (kind, len(data), sha[:16]))
out = b""
while True:
    d = s.recv(4096)
    if not d:
        break
    out += d
print(out.decode(errors="replace").strip())
sys.exit(0 if b"UPD OK" in out else 1)
