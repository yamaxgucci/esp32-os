# GPIO1 and GPIO3 are the I2C lines, so nothing may print on UART0.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# The bus is answered by polling the pins: the faster the better.
CONFIG_ESP8266_DEFAULT_CPU_FREQ_160=y
CONFIG_ESP_WIFI_STORAGE_RAM=y
CONFIG_ESPTOOLPY_FLASHSIZE_1MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# -Os: two slots of 448 KB
CONFIG_COMPILER_OPTIMIZATION_LEVEL_RELEASE=y
